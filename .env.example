# Reference only. No real credentials/endpoints in Git.
# init-local-secrets.ps1 creates .env only when absent; never overwrite an existing binding.
# Edit the local .env in your editor; do not send key values in chat.
AI_PLATFORM_REDIS_PASSWORD=
AI_PLATFORM_CORE_HOST_PORT=8765
AI_PLATFORM_CORE_CONTAINER_PORT=8080
AI_PLATFORM_AUTOSTART=false
# Optional PROCESS bootstrap paths (inside the runtime filesystem).
# Set selectors in process environment; entries inside .env are not selectors.
# AI_PLATFORM_WORKSPACE_PROFILE=config/defaults/workspace.example.json
# AI_PLATFORM_LOCAL_OVERRIDES=config/local.workspace.json
# AI_PLATFORM_ENV_FILE=.env
# Optional LLM binding: both fields together. No API call is enabled by adding them.
AI_PLATFORM_LLM_ENDPOINT=
AI_PLATFORM_LLM_API_KEY=
