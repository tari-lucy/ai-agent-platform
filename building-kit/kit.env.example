# Скопируй этот файл в kit.env и впиши свои значения.

# Адрес MCP-сервера мода UnionClef и его токен (в настройках мода: mcpPort и mcpAuthToken).
# Если агент и игра на разных машинах, адрес должен быть доступен агенту (например, через SSH-туннель).
UNIONCLEF_MCP_URL=http://127.0.0.1:25350/mcp
UNIONCLEF_MCP_TOKEN=

# Куда складывать картинки чертежей и кадры игры (относительно папки пакета или абсолютный путь).
BUILD_KIT_SHOTS=shots

# Что говорить модели, когда ей надо посмотреть картинку. Подставляются {path} (полный путь) и {file}.
# Замени на обращение к своему средству зрения, если оно называется иначе.
BUILD_KIT_LOOK_HINT=Открой изображение {path} своим средством зрения и ответь на вопрос ниже
