// AI Agent Platform adapter: the native client talks to the platform bridge `aw-opencode/1`
// (/api/v1/opencode) through this fetch. No request reaches a native OpenCode server; routes
// the platform does not offer answer empty or "not available". Ordinary conversation only:
// tickets and permission decisions stay in the platform panel (`/`).
// The native client resolves absolute paths against its server URL: it is this origin, and
// every request of the native SDK is answered here (platform.fetch), never sent over the network.
export const VIRTUAL_SERVER = location.origin
const BRIDGE = "/api/v1/opencode"
const VERSION = "1.19.3"


type Scope = Record<string, string | null | undefined>
type Agent = { directory: string; scope: Scope; label: string; profile_version: number; active_runtime: boolean }
type SessionRow = {
  id: string; scope: Scope; title: string; version: number; state: string
  last_sequence: number; processed_sequence: number; created_at?: string; updated_at?: string
}
type Entry = { sequence: number; speaker: "operator" | "character"; text: string | null; withheld: boolean; at: string; reply_to_sequence?: number | null }
type Progress = { state: string; since: string }
type Draft = { scope: Scope; utterance_id: string; version: number; revision: number; text: string | null; withheld: boolean; acknowledgeable: boolean }
type Transcript = {
  scope: Scope; session_id: string; session_version: number; state: string; title: string
  processed_sequence?: number; pending_reply?: Draft | null; entries: Entry[]; checked_at: string
  progress?: Progress | null; waiting_reason?: string | null; invalidated_reason?: string | null
  open_ticket_ids?: string[]
}

const json = (body: unknown, status = 200) =>
  new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
const unavailable = (path: string) => json({ name: "AW_NOT_AVAILABLE", data: { message: "Недоступно в рабочем окне платформы", path } }, 501)
const refused = (message: string) => json({ name: "AW_REFUSED", data: { message } }, 403)
const ms = (value?: string) => (value ? Date.parse(value) : Date.now())
const stable = (scope: Scope): Scope => ({
  workspace_id: scope.workspace_id, persona_id: scope.persona_id, memory_space_id: scope.memory_space_id, memory_mode: scope.memory_mode,
})
const uuid = () => crypto.randomUUID()

// ---- platform session (operator login lives in the panel) --------------------------------------
let csrf: Promise<string> | null = null
function token(): Promise<string> {
  csrf ??= fetch("/api/v1/auth/session", { credentials: "same-origin", cache: "no-store" }).then(async (response) => {
    if (response.status === 401) {
      location.assign("/?next=" + encodeURIComponent(location.pathname))
      throw new Error("AW_LOGIN_REQUIRED")
    }
    const body = (await response.json()) as { csrf_token: string }
    return body.csrf_token
  })
  return csrf
}
async function bridge<T>(path: string, body?: unknown): Promise<T> {
  const headers: Record<string, string> = { accept: "application/json" }
  if (body !== undefined) {
    headers["content-type"] = "application/json"
    headers["x-csrf-token"] = await token()
  } else await token()
  const response = await fetch(BRIDGE + path, {
    method: body === undefined ? "GET" : "POST", credentials: "same-origin", cache: "no-store", headers,
    body: body === undefined ? undefined : JSON.stringify(body),
  })
  if (response.status === 401) { csrf = null; location.assign("/?next=" + encodeURIComponent(location.pathname)) }
  if (!response.ok) throw Object.assign(new Error("AW_BRIDGE_" + response.status), { status: response.status, body: await response.text() })
  return (await response.json()) as T
}

// ---- owner projections, read fresh each time (no browser persistence) ---------------------------
async function agents(): Promise<Agent[]> {
  // Only work memory: ordinary conversation happens there. Test areas stay in the panel
  // (laboratory); they are not deleted, just not offered in this window.
  return (await bridge<{ items: Agent[] }>("/agents")).items.filter((agent) => agent.scope.memory_mode === "work")
}
const isTest = (agent: Agent) => agent.scope.memory_mode === "test"
async function agentOf(directory: string | null | undefined): Promise<Agent | undefined> {
  const all = await agents()
  return all.find((agent) => agent.directory === directory) ?? (directory ? undefined : all[0])
}
const sessionOwner = new Map<string, string>() // session id -> directory, learnt from owner lists
async function sessions(directory: string): Promise<SessionRow[]> {
  const rows = (await bridge<{ items: SessionRow[] }>(`/agents/${directory}/sessions?limit=50`)).items
  for (const row of rows) sessionOwner.set(row.id, directory)
  return rows
}
async function directoryOf(sessionID: string): Promise<string | undefined> {
  if (sessionOwner.has(sessionID)) return sessionOwner.get(sessionID)
  for (const agent of await agents()) if ((await sessions(agent.directory)).some((row) => row.id === sessionID)) return agent.directory
  return undefined
}
const transcript = (directory: string, sessionID: string) =>
  bridge<Transcript>(`/agents/${directory}/sessions/${encodeURIComponent(sessionID)}`)

// ---- native shapes ------------------------------------------------------------------------------
const project = (agent: Agent) => ({
  id: agent.directory, worktree: agent.directory, name: isTest(agent) ? `${agent.label} · тест` : agent.label,
  time: { created: 0, updated: 0 }, sandboxes: [],
})
const tokens = { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } }
const sessionInfo = (directory: string, row: { id: string; title: string; created_at?: string; updated_at?: string }) => ({
  id: row.id, projectID: directory, title: row.title, cost: 0, tokens,
  time: { created: ms(row.created_at), updated: ms(row.updated_at) }, location: { directory },
})
// Session events still carry the legacy (v1) session shape.
const sessionEventInfo = (directory: string, row: { id: string; title: string; created_at?: string; updated_at?: string }) => ({
  id: row.id, slug: row.id, projectID: directory, directory, title: row.title, version: VERSION,
  time: { created: ms(row.created_at), updated: ms(row.updated_at) },
})
const model = { id: "platform", providerID: "aw" }
const GATEWAY_PROVIDER = { id: "aw", name: "AI Agent Platform", package: "aw" }
const GATEWAY_MODEL = {
  id: "platform", modelID: "platform", providerID: "aw", name: "Модель платформы",
  capabilities: { tools: false, input: ["text"], output: ["text"] }, variants: [], time: { released: 0 },
  cost: [], status: "active", enabled: true, limit: { context: 16000, output: 1024 },
}
const personAgent = (agent: Agent) => ({
  id: agent.label, name: agent.label, model, mode: "primary", hidden: false, permissions: [],
  description: "Личность платформы: её память, права и бюджет", request: { settings: {}, headers: {}, body: {} },
})
// A reply keeps one id from draft to delivered entry: "reply-<operator message it answers>".
const replyID = (sequence: number, n = 1) => (n === 1 ? `reply-${sequence}` : `reply-${sequence}-${n}`)
const assistant = (view: Transcript, id: string, text: string, at: string, done: boolean) => ({
  id, type: "assistant", agent: view.scope.persona_id ?? "", model,
  time: done ? { created: ms(at), completed: ms(at) } : { created: ms(at) }, finish: done ? "stop" : undefined,
  content: [{ type: "text", text }],
})
// The platform's own words about the current turn: a system note, never the person's text.
const PROGRESS: Record<string, string> = {
  waiting_start: "Сообщение сохранено и ждёт, пока эта личность будет запущена (START в панели).",
  queued: "Сообщение принято: ход ждёт своей очереди.",
  running: "Агент выполняет рабочий ход.",
  failed: "Рабочий ход завершился ошибкой. Повторно ничего само не отправится: напишите сообщение ещё раз.",
  cancelled: "Рабочий ход отменён (STOP или отзыв допуска). Ответа нет.",
  unknown: "Исход рабочего хода не подтверждён; платформа не повторяет его вслепую.",
}
// Client message ids of messages sent from this page (page lifetime only, never persisted).
const clientIDs = new Map<string, string>()
function messages(view: Transcript) {
  const rows: Record<string, unknown>[] = []
  let lastOperator = 0
  const replies = new Map<number, number>()
  for (const entry of view.entries) {
    const text = entry.withheld ? "Скрыто: основание сообщения недоступно." : (entry.text ?? "")
    if (entry.speaker === "operator") {
      lastOperator = entry.sequence
      rows.push({ id: clientIDs.get(`${view.session_id}:${entry.sequence}`) ?? `msg-${entry.sequence}`, type: "user", time: { created: ms(entry.at) }, text })
    } else {
      const answered = entry.reply_to_sequence ?? entry.sequence
      const n = (replies.get(answered) ?? 0) + 1
      replies.set(answered, n)
      rows.push(assistant(view, replyID(answered, n), text, entry.at, true))
    }
  }
  // A reply after a ticket answer is a further reply to the same operator message.
  const next = replyID(lastOperator, (replies.get(lastOperator) ?? 0) + 1)
  const draft = view.pending_reply
  if (draft && !draft.withheld && draft.text) {
    rows.push(assistant(view, next, draft.text, view.checked_at, true))
    if (draft.acknowledgeable) watchReceipt(draft, view.session_id, next)
  } else if (view.invalidated_reason && !lastOperator) {
    // The stopped conversation's history is no longer shown: a platform placeholder in the
    // operator's place and the stop notice in the reply's place (both platform words).
    rows.push({ id: `stopped-${view.session_version}`, type: "user", time: { created: ms(view.checked_at) },
      text: "Сообщения этого разговора больше не показываются." })
    rows.push(notice(view, `stopped-${view.session_version}-notice`, STOPPED, view.checked_at))
  } else if (view.invalidated_reason || view.waiting_reason === "message_unavailable") {
    rows.push(notice(view, next, STOPPED, view.checked_at))
  } else if (view.open_ticket_ids?.length) {
    // The person asked the operator in a ticket; answers and decisions live in the panel.
    rows.push(notice(view, next, waitingTicket(view.open_ticket_ids[0]), view.checked_at))
  } else if (view.progress && NOTICE.has(view.progress.state) && PROGRESS[view.progress.state]) {
    // A platform notice in the reply's place (never the person's words); a later reply for
    // the same operator message takes this place. Queued/running use the native busy state.
    rows.push(notice(view, next, PROGRESS[view.progress.state], view.progress.since))
  }
  return rows
}
const NOTICE = new Set(["waiting_start", "failed", "cancelled", "unknown"])
const waitingTicket = (ticketID: string) =>
  `Агент ждёт вашего ответа в обращении. Ответьте в панели: ${location.origin}/#/tickets?ticket=${encodeURIComponent(ticketID)} — разговор продолжится сам.`
const STOPPED = "Платформа: разговор остановлен — сообщение оператора отозвано, удалено или истекло и не исполнялось. Начните новый разговор."
const notice = (view: Transcript, id: string, text: string, at: string) => ({
  id, type: "assistant", agent: view.scope.persona_id ?? "", model, time: { created: ms(at), completed: ms(at) },
  finish: "error", content: [], error: { type: "PlatformNotice", message: text },
})
const running = (view: Transcript) => view.progress?.state === "running" || view.progress?.state === "queued"

// ---- receipt: ACK only after the reply is really shown in a visible tab --------------------------
type Receipt = { draft: Draft; sessionID: string; messageID: string }
type RenderedReply = { directory: string; sessionID: string; messageID: string; text?: string }
const renderedReplies = new Map<HTMLElement, () => RenderedReply>()
const receipts = new Map<string, Receipt>()
const attemptedReceipts = new Set<string>()
let receiptTimer: ReturnType<typeof setInterval> | undefined
let checkingReceipts = false
export function registerRenderedReply(element: HTMLElement, read: () => RenderedReply) {
  renderedReplies.set(element, read)
  return () => renderedReplies.delete(element)
}
export function resetReceiptState() {
  if (receiptTimer !== undefined) clearInterval(receiptTimer)
  receiptTimer = undefined
  receipts.clear()
  attemptedReceipts.clear()
  renderedReplies.clear()
}
window.addEventListener("pagehide", resetReceiptState)
function watchReceipt(draft: Draft, sessionID: string, messageID: string) {
  const key = draft.utterance_id + ":" + draft.revision
  if (draft.scope.memory_mode !== "work" || attemptedReceipts.has(key) || receipts.size >= 128) return
  for (const [old, item] of receipts) if (item.draft.utterance_id === draft.utterance_id) receipts.delete(old)
  receipts.set(key, { draft, sessionID, messageID })
  receiptTimer ??= setInterval(() => void checkReceipts().catch(() => {}), 1000)
}
function visibleReply(element: HTMLElement): Promise<boolean> {
  if (document.visibilityState !== "visible" || !element.isConnected
    || element.checkVisibility?.({ checkOpacity: true, checkVisibilityCSS: true }) === false) return Promise.resolve(false)
  return new Promise(resolve => {
    const finish = (value: boolean) => { clearTimeout(timer); observer.disconnect(); resolve(value) }
    const observer = new IntersectionObserver(entries => finish(entries.some(entry => entry.isIntersecting && entry.intersectionRatio >= 0.6)), { threshold: [0, 0.6, 1] })
    const timer = setTimeout(() => finish(false), 250)
    observer.observe(element)
  })
}
export async function checkReceipts() {
  if (checkingReceipts || document.visibilityState !== "visible" || !receipts.size) return
  checkingReceipts = true
  try {
    const allowed = await agents()
    for (const [key, item] of receipts) {
      const { draft, sessionID, messageID } = item
      const dir = allowed.find(agent => ["workspace_id", "persona_id", "memory_space_id", "memory_mode"].every(field => agent.scope[field] === draft.scope[field]))?.directory
      if (!dir || !draft.text) continue
      for (const [element, read] of renderedReplies) {
        if (!element.isConnected) { renderedReplies.delete(element); continue }
        const matches = () => {
          const shown = read()
          return shown.directory === dir && shown.sessionID === sessionID && shown.messageID === messageID && shown.text === draft.text
        }
        if (!matches() || !await visibleReply(element)) continue
        const fresh = await transcript(dir, sessionID)
        const latest = fresh.pending_reply
        if (receipts.get(key) !== item || !latest?.acknowledgeable || latest.withheld
          || latest.utterance_id !== draft.utterance_id || latest.revision !== draft.revision
          || latest.version !== draft.version || latest.text !== draft.text) continue
        if (!matches() || !await visibleReply(element) || attemptedReceipts.has(key)) continue
        attemptedReceipts.add(key)
        if (attemptedReceipts.size > 512) attemptedReceipts.delete(attemptedReceipts.values().next().value!)
        receipts.delete(key)
        // One automatic attempt; request identity also makes an explicit replay idempotent.
        // Failed/unknown ACK stays pending with the owner, never becomes delivered locally.
        await bridge(`/agents/${dir}/commands`, {
          type: "dialogue.acknowledge", request_id: `oc-receipt-${draft.utterance_id}-${draft.revision}`,
          scope: latest.scope, target: latest.utterance_id, expected_version: latest.version, arguments: { revision: latest.revision },
        }).catch(() => {})
        break
      }
    }
  } finally {
    checkingReceipts = false
  }
}

// ---- routes -------------------------------------------------------------------------------------
const EMPTY_LISTS = new Set(["/api/agent", "/api/command", "/api/model", "/api/model/default", "/api/provider", "/api/mcp",
  "/api/mcp/resource", "/api/plugin", "/api/pty", "/api/permission/request", "/api/question/request", "/api/form/request",
  "/api/reference", "/api/integration"])
function queryDirectory(url: URL): string | null {
  for (const [key, value] of url.searchParams) if (key === "directory" || key.endsWith("directory]") || key.endsWith(".directory")) return value
  return null
}
async function route(method: string, path: string, url: URL, body: () => Promise<Record<string, unknown>>): Promise<Response> {
  if (path === "/global/health") return json({}, 404) // not the legacy protocol
  if (path === "/api/health") return json({ healthy: true, version: VERSION, pid: 0 })
  if (path === "/api/project" && method === "GET") return json((await agents()).map(project))
  if (path === "/api/project/current") {
    const agent = await agentOf(url.searchParams.get("directory"))
    return agent ? json({ id: agent.directory, directory: agent.directory }) : json({ name: "NotFound" }, 404)
  }
  if (path === "/api/session" && method === "GET") {
    const directory = queryDirectory(url) ?? (await agentOf(undefined))?.directory
    if (!directory) return json({ data: [], cursor: {} })
    return json({ data: (await sessions(directory)).map((row) => sessionInfo(directory, row)), cursor: {} })
  }
  if (path === "/api/session" && method === "POST") {
    const input = await body()
    const location = input.location as { directory?: string } | undefined
    const agent = await agentOf(location?.directory ?? url.searchParams.get("directory"))
    if (!agent) return json({ name: "NotFound" }, 404)
    if (isTest(agent)) return refused("Рабочий разговор ведётся только в рабочей памяти личности. Выберите её проект без пометки «тест».")
    const receipt = await bridge<{ resource_id: string }>(`/agents/${agent.directory}/commands`, {
      type: "work.session.open", request_id: uuid(), scope: stable(agent.scope), target: "work",
      arguments: { schema_id: "work.session.open-args", data: { title: "Новый разговор" } },
    })
    sessionOwner.set(receipt.resource_id, agent.directory)
    return json({ data: sessionInfo(agent.directory, { id: receipt.resource_id, title: "Новый разговор" }) })
  }
  if (method === "GET" && path === "/api/session/active") return json({ data: {} })
  const one = /^\/api\/session\/([^/]+)(\/message|\/prompt)?(?:\/([^/]+))?$/.exec(path)
  if (one) {
    const sessionID = decodeURIComponent(one[1])
    const directory = await directoryOf(sessionID)
    if (!directory) return json({ name: "NotFound" }, 404)
    const view = await transcript(directory, sessionID)
    if (!one[2] && method === "GET") return json({ data: sessionInfo(directory, { id: sessionID, title: view.title }) })
    // Pages are newest first (the client reverses them into reading order).
    if (one[2] === "/message" && !one[3] && method === "GET") return json({ data: messages(view).toReversed(), cursor: {} })
    if (one[3] && method === "GET") {
      const found = messages(view).find((row) => row.id === decodeURIComponent(one[3]))
      return found ? json({ data: found }) : json({ name: "NotFound" }, 404)
    }
    if (one[2] === "/prompt" && method === "POST") {
      const input = await body()
      const text = String(input.text ?? "")
      const requestID = String(input.id ?? uuid())
      // The owner stores it under the next sequence (CAS on expected_version). The client already
      // shows it under its own id: keep that id for this page, so it is not shown twice.
      const send = (current: Transcript, request: string) => bridge(`/agents/${directory}/commands`, {
        type: "work.session.message", request_id: request, scope: stable(current.scope), target: sessionID,
        expected_version: current.session_version,
        arguments: { schema_id: "work.session.message-args", data: { session_id: sessionID, text } },
      })
      const last = (current: Transcript) => Math.max(0, ...current.entries.map((entry) => entry.sequence))
      let sequence = last(view) + 1
      try {
        await send(view, requestID)
      } catch (error) {
        if ((error as { status?: number }).status !== 409) throw error
        // The session moved (e.g. a receipt landed) between reading and sending. Read again:
        // if the message is already stored, do not send it twice; else one retry, new version.
        const fresh = await transcript(directory, sessionID)
        const stored = fresh.entries.findLast((entry) => entry.speaker === "operator")
        if (!(stored && stored.sequence >= sequence && stored.text === text)) {
          await send(fresh, `${requestID}:v${fresh.session_version}`)
          sequence = last(fresh) + 1
        } else sequence = stored.sequence
      }
      const id = input.id ? requestID : `msg-${sequence}`
      clientIDs.set(`${sessionID}:${sequence}`, id)
      return json({ data: { admittedSeq: 0, id, sessionID, timeCreated: Date.now(), type: "user", data: { text }, delivery: "queue" } })
    }
  }
  // Lists the platform does not provide answer empty, never a native fallback.
  if (method === "GET" && path === "/lsp") return json([])
  if (method === "GET" && EMPTY_LISTS.has(path)) {
    const agent = await agentOf(queryDirectory(url))
    const directory = agent?.directory ?? ""
    const location = { directory, project: { id: directory, directory } }
    // The one "agent" is the selected platform person itself (never Build/Plan); the one
    // "model" is the platform gateway, whose real assignment stays in the platform.
    if (path === "/api/agent") return json({ location, data: agent ? [personAgent(agent)] : [] })
    if (path === "/api/model") return json({ location, data: [GATEWAY_MODEL] })
    if (path === "/api/model/default") return json({ location, data: GATEWAY_MODEL })
    if (path === "/api/provider") return json({ location, data: [GATEWAY_PROVIDER] })
    if (path === "/api/mcp/resource") return json({ location, data: { resources: [], templates: [] } })
    return json({ location, data: [] })
  }
  return unavailable(path)
}

export const awFetch: typeof globalThis.fetch = async (input, init) => {
  const request = input instanceof Request ? input : new Request(input, init)
  const url = new URL(request.url)
  if (url.origin !== VIRTUAL_SERVER || url.pathname.startsWith("/api/v1/")) return json({ error: "AW_OUTSIDE_BRIDGE" }, 403)
  const path = url.pathname
  if (path === "/api/event") return events(request.signal)
  try {
    const response = await route(request.method, path, url, async () => (await request.json().catch(() => ({}))) as Record<string, unknown>)
    return response
  } catch (error) {
    const status = (error as { status?: number }).status ?? 502
    return json({ name: "AW_BRIDGE_ERROR", data: { status } }, status === 409 ? 409 : status)
  }
}

// ---- events: owner notifications become "refetch" signals for the native store ------------------
function events(signal: AbortSignal): Response {
  const encoder = new TextEncoder()
  const sources: EventSource[] = []
  const stream = new ReadableStream<Uint8Array>({
    async start(controller) {
      const send = (event: unknown) => controller.enqueue(encoder.encode(`data: ${JSON.stringify(event)}\n\n`))
      send({ id: uuid(), type: "server.connected", data: {} })
      for (const agent of await agents().catch(() => [] as Agent[])) {
        const source = new EventSource(`${BRIDGE}/agents/${agent.directory}/events`, { withCredentials: true })
        source.addEventListener("refetch", () => void refresh(agent.directory, send))
        sources.push(source)
      }
      signal.addEventListener("abort", () => { sources.forEach((s) => s.close()); controller.close() })
    },
    cancel() { sources.forEach((s) => s.close()) },
  })
  return new Response(stream, { headers: { "content-type": "text/event-stream" } })
}
// Ids already announced per session: a refetch announces only new ones; the client then
// fetches each by id from the owner view (no synthesized token stream, no replay of commands).
const announced = new Map<string, Set<string>>()
async function refresh(directory: string, send: (event: unknown) => void) {
  for (const row of await sessions(directory).catch(() => [] as SessionRow[])) {
    const base = { created: Date.now(), location: { directory }, durable: { aggregateID: row.id, seq: row.version, version: 1 } }
    send({ ...base, id: uuid(), type: "session.updated", data: { sessionID: row.id, info: sessionEventInfo(directory, row) } })
    const view = await transcript(directory, row.id).catch(() => undefined)
    if (!view) continue
    const known = announced.get(row.id) ?? new Set<string>()
    announced.set(row.id, known)
    for (const message of messages(view)) {
      const id = String(message.id)
      const key = id + ":" + JSON.stringify(message).length
      if (known.has(key)) continue
      known.add(key)
      send({ ...base, id: uuid(), type: "session.input.promoted", data: { sessionID: row.id, inputID: id } })
    }
    send({ ...base, id: uuid(), type: running(view) ? "session.execution.started" : "session.execution.succeeded", data: { sessionID: row.id } })
  }
}

// ---- no private browser persistence: history/context/settings live only in this page ---------
class PageStorage implements Storage {
  #map = new Map<string, string>()
  get length() { return this.#map.size }
  clear() { this.#map.clear() }
  getItem(key: string) { return this.#map.get(key) ?? null }
  key(index: number) { return [...this.#map.keys()][index] ?? null }
  removeItem(key: string) { this.#map.delete(key) }
  setItem(key: string, value: string) { this.#map.set(String(key), String(value)) }
}
export const pageStorage: Storage = new PageStorage()
const blobs = new Map<string, Blob>()
export const pageDraftDriver = {
  get: async (key: string) => pageStorage.getItem("draft:" + key),
  set: async (key: string, value: string) => pageStorage.setItem("draft:" + key, value),
  remove: async (key: string) => pageStorage.removeItem("draft:" + key),
  putBlob: async (blob: Blob) => { const id = uuid(); blobs.set(id, blob); return id },
  getBlob: async (id: string) => blobs.get(id) ?? null,
}
// The platform catalogue is the list of projects: every allowed agent, never a local folder.
export async function catalogueDirectories(): Promise<string[]> {
  return (await agents()).map((agent) => agent.directory)
}
