From 32e14d3e564176b47108dc510b6a2fda2c8b5c11 Mon Sep 17 00:00:00 2001
From: tari-lucy <tari.gpt2025@gmail.com>
Date: Sat, 24 Oct 2026 20:32:13 +0300
Subject: [PATCH] fix(platform-ui): keep session dates stable and persist
 renamed titles

---
 packages/app/src/aw/bridge.test.ts | 19 +++++++++++++++++++
 packages/app/src/aw/bridge.ts      | 21 ++++++++++++++++++---
 2 files changed, 37 insertions(+), 3 deletions(-)

diff --git a/packages/app/src/aw/bridge.test.ts b/packages/app/src/aw/bridge.test.ts
index 913ae39..db4006f 100644
--- a/packages/app/src/aw/bridge.test.ts
+++ b/packages/app/src/aw/bridge.test.ts
@@ -87,3 +87,22 @@ test("message ids are disjoint between conversations of the same person", async
   const ids = new Set(a.data.map((row: { id: string }) => row.id))
   expect(b.data.some((row: { id: string }) => ids.has(row.id))).toBe(false)
 })
+
+
+test("session clocks stay stable on detail and list refetch; rename uses the owner command", async () => {
+  const first = await (await awFetch("http://fixture.invalid/api/session/session")).json()
+  await new Promise((resolve) => setTimeout(resolve, 10))
+  const second = await (await awFetch("http://fixture.invalid/api/session/session")).json()
+  expect(first.data.time).toEqual(second.data.time)
+  const list = await (await awFetch("http://fixture.invalid/api/session?directory=aw_fixture")).json()
+  expect(list.data[0].time).toEqual(first.data.time)
+  const before = acknowledgements.length
+  const renamed = await awFetch("http://fixture.invalid/api/session/session/rename", {
+    method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ title: "A clear title" }),
+  })
+  expect(renamed.status).toBe(204)
+  expect(acknowledgements[before].type).toBe("work.session.rename")
+  expect(acknowledgements[before].expected_version).toBe(1)
+  expect(acknowledgements[before].arguments.data).toEqual({ session_id: "session", title: "A clear title" })
+  acknowledgements.splice(before)
+})
diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
index b3761b5..b223db6 100644
--- a/packages/app/src/aw/bridge.ts
+++ b/packages/app/src/aw/bridge.ts
@@ -20,6 +20,7 @@ type Progress = { state: string; since: string }
 type Draft = { scope: Scope; utterance_id: string; version: number; revision: number; text: string | null; withheld: boolean; acknowledgeable: boolean }
 type Transcript = {
   scope: Scope; session_id: string; session_version: number; state: string; title: string
+  created_at?: string; updated_at?: string
   processed_sequence?: number; pending_reply?: Draft | null; entries: Entry[]; checked_at: string
   progress?: Progress | null; waiting_reason?: string | null; invalidated_reason?: string | null
   open_ticket_ids?: string[]
@@ -29,7 +30,10 @@ const json = (body: unknown, status = 200) =>
   new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
 const unavailable = (path: string) => json({ name: "AW_NOT_AVAILABLE", data: { message: "Недоступно в рабочем окне платформы", path } }, 501)
 const refused = (message: string) => json({ name: "AW_REFUSED", data: { message } }, 403)
-const ms = (value?: string) => (value ? Date.parse(value) : Date.now())
+const ms = (value?: string | null) => {
+  const parsed = value ? Date.parse(value) : 0
+  return Number.isFinite(parsed) ? parsed : 0
+}
 const stable = (scope: Scope): Scope => ({
   workspace_id: scope.workspace_id, persona_id: scope.persona_id, memory_space_id: scope.memory_space_id, memory_mode: scope.memory_mode,
 })
@@ -294,13 +298,24 @@ async function route(method: string, path: string, url: URL, body: () => Promise
     return json({ data: sessionInfo(agent.directory, { id: receipt.resource_id, title: "Новый разговор" }) })
   }
   if (method === "GET" && path === "/api/session/active") return json({ data: {} })
-  const one = /^\/api\/session\/([^/]+)(\/message|\/prompt)?(?:\/([^/]+))?$/.exec(path)
+  const one = /^\/api\/session\/([^/]+)(\/message|\/prompt|\/rename)?(?:\/([^/]+))?$/.exec(path)
   if (one) {
     const sessionID = decodeURIComponent(one[1])
     const directory = await directoryOf(sessionID)
     if (!directory) return json({ name: "NotFound" }, 404)
     const view = await transcript(directory, sessionID)
-    if (!one[2] && method === "GET") return json({ data: sessionInfo(directory, { id: sessionID, title: view.title }) })
+    if (!one[2] && method === "GET") return json({ data: sessionInfo(directory, { ...view, id: sessionID }) })
+    if (one[2] === "/rename" && method === "POST") {
+      const input = await body()
+      if (Object.keys(input).some((key) => key !== "title") || typeof input.title !== "string" || !input.title.trim() || input.title.length > 512)
+        return json({ name: "AW_INVALID_TITLE" }, 400)
+      await bridge(`/agents/${directory}/commands`, {
+        type: "work.session.rename", request_id: uuid(), scope: stable(view.scope), target: sessionID,
+        expected_version: view.session_version,
+        arguments: { schema_id: "work.session.rename-args", data: { session_id: sessionID, title: input.title } },
+      })
+      return new Response(null, { status: 204 })
+    }
     // Pages are newest first (the client reverses them into reading order).
     if (one[2] === "/message" && !one[3] && method === "GET") return json({ data: messages(view).toReversed(), cursor: {} })
     if (one[3] && method === "GET") {
