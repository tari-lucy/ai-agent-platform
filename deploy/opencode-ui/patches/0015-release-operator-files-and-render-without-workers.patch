-const uploadName = (value: string) =>
-  value.toLowerCase().replace(/[^a-z0-9_.-]+/g, "-").replace(/^[.-]+|[.-]+$/g, "").slice(0, 200) || "file"
+async function uploadName(value: string): Promise<string> {
+  const normalized = value.toLowerCase().replace(/[^a-z0-9_.-]+/g, "-").replace(/^[.-]+|[.-]+$/g, "").slice(0, 160) || "file"
+  if (normalized === value && value.length <= 160) return normalized
+  const bytes = new TextEncoder().encode(value)
+  const hash = Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256", bytes)), b => b.toString(16).padStart(2, "0")).join("").slice(0, 16)
+  const extension = /\.([a-z0-9]{1,12})$/i.exec(value)?.[1]?.toLowerCase()
+  const stem = extension && normalized.endsWith(`.${extension}`) ? normalized.slice(0, -(extension.length + 1)) : normalized
+  return `${stem}-${hash}${extension ? `.${extension}` : ""}`
+}
