+test("owner invalidation rejects a late catalogue and keeps failure closed", async () => {
+  const pending: { resolve: (rows: any[]) => void; reject: (error: Error) => void }[] = []
+  const tree = createFileTreeStore({ scope: () => "aw_fixture", normalizeDir: x => x,
+    list: () => new Promise<any[]>((resolve, reject) => pending.push({ resolve, reject })),
+    onError: () => {} })
+  const first = tree.listDir("")
+  const invalidated = tree.invalidate()
+  pending[0].resolve([{ path: "old.txt", name: "old.txt", type: "file", absolute: "/old.txt", ignored: false }])
+  await first
+  expect(tree.children("")).toHaveLength(0)
+  // The new owner read fails; the old catalogue must not return as a fallback.
+  pending[1].reject(Error("synthetic owner unavailable"))
+  await invalidated
+  expect(tree.children("")).toHaveLength(0)
+  expect(tree.isLoaded("")).toBe(false)
+})
+
+test("repeated owner invalidation consumes a dirty tail", async () => {
+  const pending: ((rows: any[]) => void)[] = []
+  const tree = createFileTreeStore({ scope: () => "aw_fixture", normalizeDir: x => x,
+    list: () => new Promise<any[]>(resolve => pending.push(resolve)), onError: () => {} })
+  const first = tree.listDir("")
+  pending[0]([]); await first
+  const a = tree.invalidate()
+  const b = tree.invalidate()
+  expect(a).toBe(b)
+  pending[1]([{ path: "stale.txt", name: "stale.txt", type: "file", ignored: false }])
+  await new Promise(resolve => setTimeout(resolve, 0))
+  expect(tree.children("")).toHaveLength(0)
+  pending[2]([]); await a
+  expect(tree.children("")).toHaveLength(0)
+})
