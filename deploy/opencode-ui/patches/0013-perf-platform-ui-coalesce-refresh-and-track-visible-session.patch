 afterAll(() => {
   resetReceiptState()
   globalThis.fetch = originalFetch
@@ -106,3 +106,111 @@ test("session clocks stay stable on detail and list refetch; rename uses the own
   expect(acknowledgements[before].arguments.data).toEqual({ session_id: "session", title: "A clear title" })
   acknowledgements.splice(before)
 })
+
+
+test("owner bursts have one refresh in flight and only read the viewed conversation", async () => {
+  const savedFetch = globalThis.fetch
+  const savedSource = globalThis.EventSource
+  const sources: Array<{ emit: (value: unknown) => void; closed: boolean }> = []
+  const bodies: string[] = []
+  let hold = false, active = 0, peak = 0, lists = 0
+  let unblock: () => void = () => {}
+  let held = Promise.resolve()
+  globalThis.EventSource = class {
+    listeners = new Map<string, EventListener>()
+    closed = false
+    constructor() { sources.push(this) }
+    addEventListener(name: string, listener: EventListener) { this.listeners.set(name, listener) }
+    close() { this.closed = true }
+    emit(value: unknown) { this.listeners.get("refetch")?.({ data: JSON.stringify(value) } as MessageEvent) }
+  } as unknown as typeof EventSource
+  globalThis.fetch = Object.assign(async (input: RequestInfo | URL, init?: RequestInit) => {
+    const path = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url, location.origin).pathname
+    if (path.endsWith("/sessions")) lists++
+    if (/\/sessions\/(session|other)$/.test(path)) {
+      bodies.push(path.endsWith("/other") ? "other" : "session")
+      peak = Math.max(peak, ++active)
+      try { if (hold) await held; return await savedFetch(input, init) }
+      finally { active-- }
+    }
+    return savedFetch(input, init)
+  }, { preconnect: () => {} })
+  const wait = async (done: () => boolean) => {
+    for (let i = 0; i < 100 && !done(); i++) await new Promise(resolve => setTimeout(resolve, 5))
+    expect(done()).toBe(true)
+  }
+  const abort = new AbortController()
+  let reader: ReadableStreamDefaultReader<Uint8Array> | undefined
+  let releaseView = watchSession("aw_fixture", "session")
+  try {
+    await awFetch("http://fixture.invalid/api/session/session/message")
+    bodies.length = 0
+    const response = await awFetch("http://fixture.invalid/api/event", { signal: abort.signal })
+    reader = response.body!.getReader()
+    await reader.read() // connected
+    await wait(() => sources.length === 1)
+    hold = true
+    held = new Promise(resolve => { unblock = resolve })
+    for (let i = 0; i < 8; i++) sources[0].emit({ owner_event: "work-session.changed", resource_id: "session" })
+    await wait(() => bodies.length === 1)
+    for (let i = 0; i < 8; i++) sources[0].emit({ owner_event: "source.changed", resource_id: "basis" })
+    expect(peak).toBe(1)
+    hold = false; unblock()
+    await wait(() => bodies.length === 2 && active === 0)
+    await new Promise(resolve => setTimeout(resolve, 10))
+    expect(bodies).toEqual(["session", "session"])
+    const before = bodies.length, oldLists = lists
+    sources[0].emit({ owner_event: "work-session.changed", resource_id: "other" })
+    await wait(() => lists > oldLists)
+    await new Promise(resolve => setTimeout(resolve, 10))
+    expect(bodies.length).toBe(before) // metadata update of a non-viewed conversation
+    // A prefetch must not change the actual viewed A.
+    await awFetch("http://fixture.invalid/api/session/other/message")
+    bodies.length = 0
+    sources[0].emit({ owner_event: "work-session.changed", resource_id: "session" })
+    await wait(() => bodies.length === 1 && active === 0)
+    expect(bodies).toEqual(["session"])
+    releaseView(); releaseView = watchSession("aw_fixture", "other")
+    bodies.length = 0
+    sources[0].emit({ owner_event: "source.changed", resource_id: "revoked-basis" })
+    await wait(() => bodies.length === 1 && active === 0)
+    expect(bodies).toEqual(["other"]) // source invalidation still rechecks the viewed text
+    releaseView(); releaseView = watchSession("aw_fixture", "session") // cached return A
+    bodies.length = 0
+    sources[0].emit({ owner_event: "source.changed", resource_id: "revoked-a" })
+    await wait(() => bodies.length === 1 && active === 0)
+    expect(bodies).toEqual(["session"])
+    await reader.cancel()
+    expect(sources[0].closed).toBe(true)
+    const after = lists
+    sources[0].emit({ owner_event: "source.changed", resource_id: "late" })
+    await new Promise(resolve => setTimeout(resolve, 10))
+    expect(lists).toBe(after)
+  } finally {
+    releaseView(); unblock(); await reader?.cancel().catch(() => {}); abort.abort()
+    globalThis.fetch = savedFetch
+    globalThis.EventSource = savedSource
+  }
+})
+
+
+test("cached route return settles a pre-revocation prefetch before a fresh owner read", async () => {
+  let finishOld: () => void = () => {}
+  const old = new Promise<void>(resolve => { finishOld = resolve })
+  const phases: string[] = []
+  let allowed = true
+  const refreshing = refreshViewedSession(async force => {
+    if (!force) { phases.push("join-old"); await old; return "old private body" }
+    phases.push("fresh-owner")
+    return allowed ? "body" : "withheld"
+  })
+  expect(phases).toEqual(["join-old"])
+  allowed = false
+  finishOld()
+  expect(await refreshing).toBe("withheld")
+  expect(phases).toEqual(["join-old", "fresh-owner"])
+  await expect(refreshViewedSession(async force => {
+    if (force) throw Error("owner unavailable")
+    return "old body"
+  })).rejects.toThrow("owner unavailable")
+})
diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
