   for (const agent of await agents()) if ((await sessions(agent.directory)).some((row) => row.id === sessionID)) return agent.directory
   return undefined
 }
+const activeSessions = new Map<string, { id: string; token: symbol }>()
+// Bound to the rendered route, never to GET/prefetch. No authority or body cache.
+export function watchSession(directory: string, id?: string) {
+  const token = Symbol()
+  if (id) activeSessions.set(directory, { id, token })
+  return () => { if (activeSessions.get(directory)?.token === token) activeSessions.delete(directory) }
+}
+// Settle an older prefetch before the owner's fresh route-entry read.
+export async function refreshViewedSession(reload: (force: boolean) => Promise<unknown> | void) {
+  try { await reload(false) } catch { /* The fresh read below owns the displayed outcome. */ }
+  return reload(true)
+}
 const transcript = (directory: string, sessionID: string) =>
   bridge<Transcript>(`/agents/${directory}/sessions/${encodeURIComponent(sessionID)}`)
 
