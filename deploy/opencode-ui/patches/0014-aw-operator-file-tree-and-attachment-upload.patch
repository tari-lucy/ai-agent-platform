+        // Failed/unknown ACK stays pending with the owner, never becomes delivered locally.
+        await bridge(`/agents/${dir}/commands`, {
+          type: "dialogue.acknowledge", request_id: `oc-receipt-${draft.utterance_id}-${draft.revision}`,
+          scope: latest.scope, target: latest.utterance_id, expected_version: latest.version, arguments: { revision: latest.revision },
+        }).catch(() => {})
