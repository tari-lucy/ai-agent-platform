-test("cached route return settles a pre-revocation prefetch before a fresh owner read", async () => {
-  let finishOld: () => void = () => {}
-  const old = new Promise<void>(resolve => { finishOld = resolve })
-  const phases: string[] = []
-  let allowed = true
-  const refreshing = refreshViewedSession(async force => {
-    if (!force) { phases.push("join-old"); await old; return "old private body" }
-    phases.push("fresh-owner")
-    return allowed ? "body" : "withheld"
-  })
-  expect(phases).toEqual(["join-old"])
-  allowed = false
-  finishOld()
-  expect(await refreshing).toBe("withheld")
-  expect(phases).toEqual(["join-old", "fresh-owner"])
-  await expect(refreshViewedSession(async force => {
-    if (force) throw Error("owner unavailable")
-    return "old body"
-  })).rejects.toThrow("owner unavailable")
-})
+import { afterAll, expect, test } from "bun:test"
+
+const originalFetch = globalThis.fetch
+const originalLocation = Object.getOwnPropertyDescriptor(globalThis, "location")
+Object.defineProperty(globalThis, "location", { configurable: true, value: new URL("http://fixture.invalid") })
+const json = (value: unknown) => new Response(JSON.stringify(value), { headers: { "content-type": "application/json" } })
+const scope = { workspace_id: "fixture", persona_id: "person", memory_space_id: "work", memory_mode: "work" }
+let pendingReply: any = null
+const acknowledgements: any[] = []
+const uploads: { area: string | null; name: string | null; body: Uint8Array }[] = []
+globalThis.fetch = Object.assign(async (input: RequestInfo | URL, init?: RequestInit) => {
+  const path = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url, location.origin).pathname
+  if (path.endsWith("/auth/session")) return json({ csrf_token: "synthetic" })
+  if (path.endsWith("/agents")) return json({ items: [{ directory: "aw_fixture", scope, label: "Fixture" }] })
+  if (path.endsWith("/commands")) { acknowledgements.push(JSON.parse(String(init?.body))); return json({ resource_id: "synthetic-ack" }) }
+  if (path.endsWith("/workplace-files/upload")) {
+    const query = new URL(String(input), location.origin).searchParams
+    uploads.push({ area: query.get("area"), name: query.get("name"), body: init?.body instanceof ArrayBuffer ? new Uint8Array(init.body) : new Uint8Array(await new Response(init?.body).arrayBuffer()) })
+    return json({ id: "operator-file-1", version: uploads.length })
+  }
+  if (path.endsWith("/agents/aw_fixture/files")) return json({ files: uploads.length ? [
+    { id: "operator-file-1", area: uploads[0].area, path: uploads[0].name, title: "Fixture upload", version: 1, reference: { checksum: "a".repeat(64), size_bytes: uploads[0].body.length, media_type: "text/plain" } },
+  ] : [] })
+  if (path.endsWith("/files/operator-file-1")) return json({ text: "Synthetic material body", withheld: false, truncated: false, media_type: "text/plain" })
+  if (path.endsWith("/sessions")) return json({ items: [{ id: "session", title: "Fixture", version: 1 }, { id: "other", title: "Other", version: 1 }] })
+  if (path.endsWith("/sessions/session") || path.endsWith("/sessions/other")) return json({ scope, session_id: path.endsWith("/other") ? "other" : "session", title: "Fixture", session_version: 1, state: "open", checked_at: "2026-01-01T00:00:03Z", pending_reply: pendingReply, entries: [
+    { sequence: 1, speaker: "operator", text: "Synthetic user", at: "2026-01-01T00:00:01Z" },
+    { sequence: 2, speaker: "character", reply_to_sequence: 1, text: "Synthetic reply", at: "2026-01-01T00:00:02Z" },
+  ] })
+  throw Error("Unexpected fixture route")
+}, { preconnect: () => {} })
+const { awFetch, registerRenderedReply, checkReceipts, resetReceiptState, watchSession, refreshViewedSession, awUploadFile } = await import("./bridge")
+afterAll(() => {
+  resetReceiptState()
+  globalThis.fetch = originalFetch
+  if (originalLocation) Object.defineProperty(globalThis, "location", originalLocation)
+})
+
+test("ACK requires exact registered reply, visibility and current owner revision", async () => {
+  const originalObserver = globalThis.IntersectionObserver
+  const originalVisibility = Object.getOwnPropertyDescriptor(document, "visibilityState")
+  let ratio = 0.2
+  globalThis.IntersectionObserver = class {
+    constructor(private callback: any) {}
+    observe() { queueMicrotask(() => this.callback([{ isIntersecting: ratio > 0, intersectionRatio: ratio }])) }
+    disconnect() {}
+  } as unknown as typeof IntersectionObserver
+  Object.defineProperty(document, "visibilityState", { configurable: true, value: "visible" })
+  pendingReply = { scope, utterance_id: "utterance", version: 1, revision: 1, text: "Synthetic exact reply", acknowledgeable: true, withheld: false }
+  const element = document.createElement("div")
+  element.textContent = pendingReply.text
+  element.checkVisibility = () => true
+  document.body.append(element)
+  try {
+    await awFetch("http://fixture.invalid/api/session/session/message")
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0) // Body text alone is not proof of rendering.
+    const release = registerRenderedReply(element, () => ({ directory: "aw_fixture", sessionID: "session", messageID: "session-reply-1-2", text: "Synthetic exact reply" }))
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0) // Less than 60% visible.
+    ratio = 1
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "hidden" })
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0)
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "visible" })
+    pendingReply = { ...pendingReply, revision: 2 }
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0) // Current owner revision differs from the shown candidate.
+    pendingReply = { ...pendingReply, revision: 1 }
+    await checkReceipts()
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(1)
+    expect(acknowledgements[0].arguments.revision).toBe(1)
+    release()
+  } finally {
+    resetReceiptState()
+    element.remove()
+    pendingReply = null
+    globalThis.IntersectionObserver = originalObserver
+    if (originalVisibility) Object.defineProperty(document, "visibilityState", originalVisibility)
+    else delete (document as any).visibilityState
+  }
+})
+
+test("single-message GET returns one object, not the message page", async () => {
+  const result = await awFetch("http://fixture.invalid/api/session/session/message/session-reply-1")
+  expect(result.status).toBe(200)
+  const body = await result.json()
+  expect(Array.isArray(body.data)).toBe(false)
+  expect(body.data).toMatchObject({ id: "session-reply-1", type: "assistant", content: [{ type: "text", text: "Synthetic reply" }] })
+})
+
+
+test("message ids are disjoint between conversations of the same person", async () => {
+  const a = await (await awFetch("http://fixture.invalid/api/session/session/message")).json()
+  const b = await (await awFetch("http://fixture.invalid/api/session/other/message")).json()
+  const ids = new Set(a.data.map((row: { id: string }) => row.id))
+  expect(b.data.some((row: { id: string }) => ids.has(row.id))).toBe(false)
+})
+
