+++ b/packages/app/src/context/aw-projection-race.test.ts
@@ -0,0 +1,23 @@
+import { expect, test } from "bun:test"
+import type { SessionApi, OpenCodeEvent } from "@opencode-ai/client/promise"
+import type { OpencodeClient } from "@opencode-ai/sdk/v2/client"
+import { createServerSession } from "./server-session"
+
+test("projects a fetched assistant when its user hydrates later", async () => {
+  const pending = new Map<string, (value: unknown) => void>()
+  const api = {
+    message: ({ messageID }: { messageID: string }) => new Promise(resolve => pending.set(messageID, resolve)),
+  } as unknown as SessionApi
+  const store = createServerSession({} as OpencodeClient, api, {} as never, { protocol: Promise.resolve("v2") })
+  store.remember({ id: "session", slug: "session", projectID: "project", directory: "/fixture", title: "Fixture", version: "1", time: { created: 1, updated: 1 } })
+  const event = (id: string) => ({ id: `event-${id}`, type: "session.input.promoted", created: 300, data: { sessionID: "session", inputID: id } }) as OpenCodeEvent
+  store.applyV2(event("msg-1"))
+  store.applyV2(event("reply-1"))
+  pending.get("reply-1")!({ id: "reply-1", type: "assistant", agent: "fixture", model: { id: "model", providerID: "fixture" }, time: { created: 200, completed: 300 }, finish: "stop", content: [{ type: "text", text: "Synthetic reply" }] })
+  await new Promise(resolve => setTimeout(resolve, 0))
+  pending.get("msg-1")!({ id: "msg-1", type: "user", text: "Synthetic user", time: { created: 100 } })
+  await new Promise(resolve => setTimeout(resolve, 0))
+  expect(store.data.session_message.session.map(item => item.id)).toEqual(["msg-1", "reply-1"])
+  expect(store.data.message.session.map(item => item.id)).toEqual(["msg-1", "reply-1"])
+  expect(store.data.part["reply-1"][0]).toMatchObject({ type: "text", text: "Synthetic reply" })
+})
