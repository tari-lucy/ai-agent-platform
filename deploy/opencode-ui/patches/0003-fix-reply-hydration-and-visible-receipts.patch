new file mode 100644
index 0000000..3729b47
--- /dev/null
+++ b/packages/app/src/aw/bridge.test.ts
@@ -0,0 +1,81 @@
+import { afterAll, expect, test } from "bun:test"
+
+const originalFetch = globalThis.fetch
+const originalLocation = Object.getOwnPropertyDescriptor(globalThis, "location")
+Object.defineProperty(globalThis, "location", { configurable: true, value: new URL("http://fixture.invalid") })
+const json = (value: unknown) => new Response(JSON.stringify(value), { headers: { "content-type": "application/json" } })
+const scope = { workspace_id: "fixture", persona_id: "person", memory_space_id: "work", memory_mode: "work" }
+let pendingReply: any = null
+const acknowledgements: any[] = []
+globalThis.fetch = async (input, init) => {
+  const path = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url, location.origin).pathname
+  if (path.endsWith("/auth/session")) return json({ csrf_token: "synthetic" })
+  if (path.endsWith("/agents")) return json({ items: [{ directory: "aw_fixture", scope, label: "Fixture" }] })
+  if (path.endsWith("/commands")) { acknowledgements.push(JSON.parse(String(init?.body))); return json({ resource_id: "synthetic-ack" }) }
+  if (path.endsWith("/sessions")) return json({ items: [{ id: "session", title: "Fixture", version: 1 }] })
+  if (path.endsWith("/sessions/session")) return json({ scope, session_id: "session", title: "Fixture", session_version: 1, state: "open", checked_at: "2026-01-01T00:00:03Z", pending_reply: pendingReply, entries: [
+    { sequence: 1, speaker: "operator", text: "Synthetic user", at: "2026-01-01T00:00:01Z" },
+    { sequence: 2, speaker: "character", reply_to_sequence: 1, text: "Synthetic reply", at: "2026-01-01T00:00:02Z" },
+  ] })
+  throw Error("Unexpected fixture route")
+}
+const { awFetch, registerRenderedReply, checkReceipts, resetReceiptState } = await import("./bridge")
+afterAll(() => {
+  resetReceiptState()
+  globalThis.fetch = originalFetch
+  if (originalLocation) Object.defineProperty(globalThis, "location", originalLocation)
+})
+
+test("ACK requires exact registered reply, visibility and current owner revision", async () => {
+  const originalObserver = globalThis.IntersectionObserver
+  const originalVisibility = Object.getOwnPropertyDescriptor(document, "visibilityState")
+  let ratio = 0.2
+  globalThis.IntersectionObserver = class {
+    constructor(private callback: any) {}
+    observe() { queueMicrotask(() => this.callback([{ isIntersecting: ratio > 0, intersectionRatio: ratio }])) }
+    disconnect() {}
+  } as unknown as typeof IntersectionObserver
+  Object.defineProperty(document, "visibilityState", { configurable: true, value: "visible" })
+  pendingReply = { scope, utterance_id: "utterance", version: 1, revision: 1, text: "Synthetic exact reply", acknowledgeable: true, withheld: false }
+  const element = document.createElement("div")
+  element.textContent = pendingReply.text
+  element.checkVisibility = () => true
+  document.body.append(element)
+  try {
+    await awFetch("http://fixture.invalid/api/session/session/message")
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0) // Body text alone is not proof of rendering.
+    const release = registerRenderedReply(element, () => ({ directory: "aw_fixture", sessionID: "session", messageID: "reply-1", text: "Synthetic exact reply" }))
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0) // Less than 60% visible.
+    ratio = 1
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "hidden" })
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0)
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "visible" })
+    pendingReply = { ...pendingReply, revision: 2 }
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(0) // Current owner revision differs from the shown candidate.
+    pendingReply = { ...pendingReply, revision: 1 }
+    await checkReceipts()
+    await checkReceipts()
+    expect(acknowledgements).toHaveLength(1)
+    expect(acknowledgements[0].arguments.revision).toBe(1)
+    release()
+  } finally {
+    resetReceiptState()
+    element.remove()
+    pendingReply = null
+    globalThis.IntersectionObserver = originalObserver
+    if (originalVisibility) Object.defineProperty(document, "visibilityState", originalVisibility)
+    else delete (document as any).visibilityState
+  }
+})
+
+test("single-message GET returns one object, not the message page", async () => {
+  const result = await awFetch("http://fixture.invalid/api/session/session/message/reply-1")
+  expect(result.status).toBe(200)
+  const body = await result.json()
+  expect(Array.isArray(body.data)).toBe(false)
+  expect(body.data).toMatchObject({ id: "reply-1", type: "assistant", content: [{ type: "text", text: "Synthetic reply" }] })
+})
