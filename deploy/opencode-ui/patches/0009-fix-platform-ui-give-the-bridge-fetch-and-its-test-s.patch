From 608a5c76ce5ff520764006216696c0260967704b Mon Sep 17 00:00:00 2001
From: Claude Code <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 15:44:04 +0000
Subject: [PATCH] fix(platform-ui): give the bridge fetch and its test stub a
 no-op preconnect (TS2741)

---
 packages/app/src/aw/bridge.test.ts | 4 ++--
 packages/app/src/aw/bridge.ts      | 6 +++++-
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/packages/app/src/aw/bridge.test.ts b/packages/app/src/aw/bridge.test.ts
index b643af0..562616c 100644
--- a/packages/app/src/aw/bridge.test.ts
+++ b/packages/app/src/aw/bridge.test.ts
@@ -7,7 +7,7 @@ const json = (value: unknown) => new Response(JSON.stringify(value), { headers:
 const scope = { workspace_id: "fixture", persona_id: "person", memory_space_id: "work", memory_mode: "work" }
 let pendingReply: any = null
 const acknowledgements: any[] = []
-globalThis.fetch = async (input, init) => {
+globalThis.fetch = Object.assign(async (input: RequestInfo | URL, init?: RequestInit) => {
   const path = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url, location.origin).pathname
   if (path.endsWith("/auth/session")) return json({ csrf_token: "synthetic" })
   if (path.endsWith("/agents")) return json({ items: [{ directory: "aw_fixture", scope, label: "Fixture" }] })
@@ -18,7 +18,7 @@ globalThis.fetch = async (input, init) => {
     { sequence: 2, speaker: "character", reply_to_sequence: 1, text: "Synthetic reply", at: "2026-01-01T00:00:02Z" },
   ] })
   throw Error("Unexpected fixture route")
-}
+}, { preconnect: () => {} })
 const { awFetch, registerRenderedReply, checkReceipts, resetReceiptState } = await import("./bridge")
 afterAll(() => {
   resetReceiptState()
diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
index 9c6a30a..16fe0a8 100644
--- a/packages/app/src/aw/bridge.ts
+++ b/packages/app/src/aw/bridge.ts
@@ -355,7 +355,7 @@ async function route(method: string, path: string, url: URL, body: () => Promise
   return unavailable(path)
 }
 
-export const awFetch: typeof globalThis.fetch = async (input, init) => {
+async function bridgeFetch(input: RequestInfo | URL, init?: RequestInit): Promise<Response> {
   const request = input instanceof Request ? input : new Request(input, init)
   const url = new URL(request.url)
   if (url.origin !== VIRTUAL_SERVER || url.pathname.startsWith("/api/v1/")) return json({ error: "AW_OUTSIDE_BRIDGE" }, 403)
@@ -370,6 +370,10 @@ export const awFetch: typeof globalThis.fetch = async (input, init) => {
   }
 }
 
+// Platform.fetch is `typeof fetch`, which under Bun types also carries `preconnect`. The bridge opens
+// no connections of its own, so preconnect is a deliberate no-op rather than a cast or a looser type.
+export const awFetch: typeof globalThis.fetch = Object.assign(bridgeFetch, { preconnect: () => {} })
+
 // ---- events: owner notifications become "refetch" signals for the native store ------------------
 function events(signal: AbortSignal): Response {
   const encoder = new TextEncoder()
-- 
2.43.0

