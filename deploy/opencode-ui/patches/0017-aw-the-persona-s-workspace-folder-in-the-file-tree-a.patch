 ]
 let catalogue = [{ directory: "aw_fixture", scope, label: "Fixture" }]
+const homeInbox = new Map<string, Uint8Array>()
 const uploads: { persona: string | null; area: string | null; name: string | null; body: Uint8Array }[] = []
 globalThis.fetch = Object.assign(async (input: RequestInfo | URL, init?: RequestInit) => {
   const path = new URL(typeof input === "string" ? input : input instanceof URL ? input.href : input.url, location.origin).pathname
@@ -23,6 +24,28 @@ globalThis.fetch = Object.assign(async (input: RequestInfo | URL, init?: Request
     uploads.push({ persona: query.get("persona_id"), area: query.get("area"), name: query.get("name"), body: init?.body instanceof ArrayBuffer ? new Uint8Array(init.body) : new Uint8Array(await new Response(init?.body).arrayBuffer()) })
     return json({ id: "operator-file-1", version: uploads.length })
   }
+  const home = /\/agents\/aw_fixture\/(home-file|home-inbox|home)(?:\/(.*))?$/.exec(path)
+  if (home) {
+    const [, kind, rest] = home
+    const inner = decodeURIComponent(rest ?? "")
+    if (kind === "home-inbox") {
+      if (homeInbox.has(inner)) return new Response("{}", { status: 409 })
+      homeInbox.set(inner, new Uint8Array(await new Response(init?.body).arrayBuffer()))
+      return json({ path: "inbox/" + inner, size: homeInbox.get(inner)!.length })
+    }
+    if (kind === "home") {
+      if (inner === "") return json({ entries: [
+        { name: "projects", type: "directory", size: 0 }, { name: "README.md", type: "file", size: 9 },
+        { name: "escape", type: "link", size: 11 }, { name: "inbox", type: "directory", size: 0 },
+      ] })
+      if (inner === "inbox") return json({ entries: [...homeInbox.keys()].map((name) => ({ name, type: "file", size: 1 })) })
+      return new Response("{}", { status: 404 })
+    }
+    if (inner === "README.md") return json({ text: "Мой порядок", size: 21, truncated: false })
+    if (inner === "big.log") return json({ text: "head", size: 5000000, truncated: true })
+    if (inner === "tool.bin") return json({ text: null, size: 10, truncated: false })
+    return new Response("{}", { status: 404 })
+  }
   if (path.endsWith("/agents/aw_fixture/files")) return json({ files: uploads.length ? [
     { id: "operator-file-1", area: uploads[0].area, path: uploads[0].name, title: "Fixture upload", version: 1, reference: { checksum: "a".repeat(64), size_bytes: uploads[0].body.length, media_type: "text/plain" } },
   ] : [] })
@@ -304,3 +327,39 @@ test("uploads bind the selected persona, reject missing scope, and keep Cyrillic
     expect(uploads.at(-1)!.name).not.toBe(uploads.at(-2)!.name)
   } finally { catalogue = originalCatalogue; window.prompt = originalPrompt }
 })
+
+test("the persona's own folder is a read-only tree and the operator drops files into its inbox", async () => {
+  const get = async (url: string) => JSON.parse(await (await awFetch("http://fixture.invalid" + url)).text())
+  const root = await get("/file?directory=aw_fixture&path=")
+  expect(root.map((row: any) => row.name)).toContain("workspace")
+  // Directories first, links and special files are never shown as openable.
+  expect(await get("/file?directory=aw_fixture&path=/workspace")).toEqual([
+    { name: "inbox", path: "/workspace/inbox", absolute: "/workspace/inbox", type: "directory", ignored: false },
+    { name: "projects", path: "/workspace/projects", absolute: "/workspace/projects", type: "directory", ignored: false },
+    { name: "README.md", path: "/workspace/README.md", absolute: "/workspace/README.md", type: "file", ignored: false },
+  ])
+  expect(await get("/file?directory=aw_fixture&path=/workspace/absent")).toEqual([])
+  expect(await get("/file/content?directory=aw_fixture&path=workspace/README.md")).toEqual({ type: "text", content: "Мой порядок", mimeType: "text/plain" })
+  expect((await get("/file/content?directory=aw_fixture&path=workspace/big.log")).content).toContain("всего 5000000 байт")
+  expect((await get("/file/content?directory=aw_fixture&path=workspace/tool.bin")).type).toBe("binary")
+  expect((await awFetch("http://fixture.invalid/file/content?directory=aw_fixture&path=workspace/none")).status).toBe(404)
+
+  const originalPrompt = window.prompt
+  const originalAlert = window.alert
+  const alerts: string[] = []
+  window.prompt = () => "workspace"
+  window.alert = (message?: string) => { alerts.push(String(message)) }
+  try {
+    const before = uploads.length
+    const sent = await awUploadFile("aw_fixture", "brief.txt", "text/plain", new Blob(["Do this"]))
+    expect(sent).toEqual({ area: "workspace", path: "inbox/brief.txt", file_id: "", version: 0 })
+    expect(new TextDecoder().decode(homeInbox.get("brief.txt"))).toBe("Do this")
+    expect(uploads.length).toBe(before) // not the managed files owner
+    expect(await awUploadFile("aw_fixture", "brief.txt", "text/plain", new Blob(["again"]))).toBeNull()
+    expect(alerts.at(-1)).toContain("brief.txt")
+    expect((await get("/file?directory=aw_fixture&path=/workspace/inbox")).map((row: any) => row.name)).toEqual(["brief.txt"])
+  } finally {
+    window.prompt = originalPrompt
+    window.alert = originalAlert
+  }
+})
diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
index 6039f7f..ece1c12 100644
--- a/packages/app/src/aw/bridge.ts
+++ b/packages/app/src/aw/bridge.ts
@@ -112,7 +112,43 @@ const transcript = (directory: string, sessionID: string) =>
 // Path space is /<area>/<logical path> of the platform catalogue. No host path is ever shown or
 // resolved; every read goes through the same owner projection and release checks as the panel.
 const AREAS = ["inbox", "knowledge", "projects", "skills", "exports"] as const
-const UPLOAD_AREAS = ["inbox", "knowledge", "projects"] as const
+const UPLOAD_AREAS = ["inbox", "knowledge", "projects", "workspace"] as const
+// The persona's own persistent folder (W4): read through the platform, never mounted here.
+const HOME = "workspace"
+type HomeEntry = { name: string; type: "directory" | "file" | "link" | "other"; size: number }
+const homePath = (path: string) => path.split("/").filter(Boolean).map(encodeURIComponent).join("/")
+async function homeNodes(directory: string, dir: string) {
+  const inner = dir.replace(/^\/+|\/+$/g, "").slice(HOME.length).replace(/^\/+/, "")
+  try {
+    const view = await bridge<{ entries: HomeEntry[] }>(`/agents/${directory}/home/${homePath(inner)}`)
+    return view.entries
+      .filter((entry) => entry.type === "directory" || entry.type === "file")
+      .map((entry) => treeNode(entry.name, `/${HOME}/${inner ? inner + "/" : ""}${entry.name}`, entry.type as "file" | "directory"))
+      .sort((a, b) => (a.type === b.type ? a.name.localeCompare(b.name) : a.type === "directory" ? -1 : 1))
+  } catch {
+    return [] // homes off (503) or a missing folder: an empty node, not an error page
+  }
+}
+const isHome = (path: string) => {
+  const clean = path.replace(/^\/+/, "")
+  return clean === HOME || clean.startsWith(HOME + "/")
+}
+async function homeContent(directory: string, virtualPath: string): Promise<Response> {
+  const inner = virtualPath.replace(/^\/+/, "").slice(HOME.length + 1)
+  try {
+    const view = await bridge<{ text: string | null; size: number; truncated: boolean }>(
+      `/agents/${directory}/home-file/${homePath(inner)}`,
+    )
+    if (view.text === null) return json({ type: "binary", content: "", mimeType: "application/octet-stream" })
+    return json({
+      type: "text",
+      content: view.truncated ? view.text + `\n\n… платформа: показано начало, всего ${view.size} байт.` : view.text,
+      mimeType: "text/plain",
+    })
+  } catch {
+    return json({ name: "NotFound" }, 404)
+  }
+}
 type LibraryFile = {
   id: string; area: string; path: string; title: string; version: number
   reference: { checksum: string; size_bytes: number; media_type: string }
@@ -131,7 +167,7 @@ const treeNode = (name: string, full: string, type: "file" | "directory") => ({
 })
 function treeNodes(files: LibraryFile[], dir: string) {
   const clean = dir.replace(/^\/+|\/+$/g, "")
-  if (!clean) return AREAS.map((area) => treeNode(area, "/" + area, "directory"))
+  if (!clean) return [...AREAS, HOME].map((area) => treeNode(area, "/" + area, "directory"))
   const segments = clean.split("/")
   const [area, ...rest] = segments
   const wanted = rest.join("/")
@@ -201,6 +237,18 @@ export async function awUploadFile(directory: string, name: string, mime: string
     window.alert(`Недопустимая область «${area}». Доступны: ${UPLOAD_AREAS.join(", ")}.`)
     return null
   }
+  if (area === HOME) {
+    // Straight into the persona's own inbox/ (W4); never overwrites an existing file.
+    const response = await fetch(`${BRIDGE}/agents/${agent.directory}/home-inbox/${encodeURIComponent(logicalName)}`, {
+      method: "POST", credentials: "same-origin", cache: "no-store",
+      headers: { "content-type": "application/octet-stream", "x-csrf-token": await token() },
+      body: bytes,
+    })
+    if (response.status === 401) { csrf = null; location.assign("/"); return null }
+    if (response.status === 409) { window.alert(`В inbox уже есть «${logicalName}». Переименуйте файл.`); return null }
+    if (!response.ok) throw Object.assign(new Error("AW_UPLOAD_" + response.status), { status: response.status })
+    return { area, path: "inbox/" + logicalName, file_id: "", version: 0 }
+  }
   const query = new URLSearchParams({
     workspace_id: String(agent.scope.workspace_id ?? ""),
     persona_id: String(agent.scope.persona_id ?? ""),
@@ -514,16 +562,21 @@ async function route(method: string, path: string, url: URL, body: () => Promise
   if (path === "/file" && method === "GET") {
     const directory = queryDirectory(url) ?? (await agentOf(undefined))?.directory
     if (!directory) return json([])
-    return json(treeNodes(await library(directory), url.searchParams.get("path") ?? ""))
+    const wanted = url.searchParams.get("path") ?? ""
+    if (isHome(wanted)) return json(await homeNodes(directory, wanted))
+    return json(treeNodes(await library(directory), wanted))
   }
   if (path === "/file/content" && method === "GET") {
     const directory = queryDirectory(url) ?? (await agentOf(undefined))?.directory
     if (!directory) return json({ name: "NotFound" }, 404)
-    return fileContent(directory, url.searchParams.get("path") ?? "")
+    const wanted = url.searchParams.get("path") ?? ""
+    if (isHome(wanted)) return homeContent(directory, wanted)
+    return fileContent(directory, wanted)
   }
   if (path === "/api/fs/list" && method === "GET") {
     const directory = queryDirectory(url) ?? (await agentOf(undefined))?.directory
-    const rows = directory ? treeNodes(await library(directory), url.searchParams.get("path") ?? "") : []
+    const wanted = url.searchParams.get("path") ?? ""
+    const rows = !directory ? [] : isHome(wanted) ? await homeNodes(directory, wanted) : treeNodes(await library(directory), wanted)
     return json({ location: locationOf(directory ?? ""), data: rows.map((row) => ({ path: row.path, type: row.type })) })
   }
   if (path === "/api/fs/find" && method === "GET") {
