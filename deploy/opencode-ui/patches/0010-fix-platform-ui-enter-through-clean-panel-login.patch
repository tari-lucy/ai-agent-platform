From 8c8348dcc4b74befd138a85be9b20f2c6ab0a010 Mon Sep 17 00:00:00 2001
From: tari-lucy <tari.gpt2025@gmail.com>
Date: Sat, 24 Oct 2026 19:35:33 +0300
Subject: [PATCH] fix(platform-ui): enter through the clean panel login URL

---
 packages/app/src/aw/bridge.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
index 16fe0a8..1f65a62 100644
--- a/packages/app/src/aw/bridge.ts
+++ b/packages/app/src/aw/bridge.ts
@@ -40,7 +40,7 @@ let csrf: Promise<string> | null = null
 function token(): Promise<string> {
   csrf ??= fetch("/api/v1/auth/session", { credentials: "same-origin", cache: "no-store" }).then(async (response) => {
     if (response.status === 401) {
-      location.assign("/?next=" + encodeURIComponent(location.pathname))
+      location.assign("/")
       throw new Error("AW_LOGIN_REQUIRED")
     }
     const body = (await response.json()) as { csrf_token: string }
@@ -58,7 +58,7 @@ async function bridge<T>(path: string, body?: unknown): Promise<T> {
     method: body === undefined ? "GET" : "POST", credentials: "same-origin", cache: "no-store", headers,
     body: body === undefined ? undefined : JSON.stringify(body),
   })
-  if (response.status === 401) { csrf = null; location.assign("/?next=" + encodeURIComponent(location.pathname)) }
+  if (response.status === 401) { csrf = null; location.assign("/") }
   if (!response.ok) throw Object.assign(new Error("AW_BRIDGE_" + response.status), { status: response.status, body: await response.text() })
   return (await response.json()) as T
 }
-- 
