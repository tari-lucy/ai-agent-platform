 packages/app/src/aw/bridge.test.ts | 20 +++++++++++++-
 packages/app/src/aw/bridge.ts      | 43 +++++++++++++++++++++++-------
 2 files changed, 53 insertions(+), 10 deletions(-)

diff --git a/packages/app/src/aw/bridge.test.ts b/packages/app/src/aw/bridge.test.ts
index b50e1bd..1d7e7b9 100644
--- a/packages/app/src/aw/bridge.test.ts
+++ b/packages/app/src/aw/bridge.test.ts
@@ -7,6 +7,10 @@ const json = (value: unknown) => new Response(JSON.stringify(value), { headers:
 const scope = { workspace_id: "fixture", persona_id: "person", memory_space_id: "work", memory_mode: "work" }
 let pendingReply: any = null
 const acknowledgements: any[] = []
+const otherSteps = [
+  { tool: "bash", status: "completed", input: '{"command": "python3 parse.py"}', output: "port 56733", output_chars: 900 },
+  { tool: "helpers_run_script", status: "error", input: '{"file_id": "cut', output: "ACCESS_DENIED", output_chars: 13 },
+]
 let catalogue = [{ directory: "aw_fixture", scope, label: "Fixture" }]
 const uploads: { persona: string | null; area: string | null; name: string | null; body: Uint8Array }[] = []
 globalThis.fetch = Object.assign(async (input: RequestInfo | URL, init?: RequestInit) => {
@@ -26,7 +30,8 @@ globalThis.fetch = Object.assign(async (input: RequestInfo | URL, init?: Request
   if (path.endsWith("/sessions")) return json({ items: [{ id: "session", title: "Fixture", version: 1 }, { id: "other", title: "Other", version: 1 }] })
   if (path.endsWith("/sessions/session") || path.endsWith("/sessions/other")) return json({ scope, session_id: path.endsWith("/other") ? "other" : "session", title: "Fixture", session_version: 1, state: "open", checked_at: "2026-01-01T00:00:03Z", pending_reply: pendingReply, entries: [
     { sequence: 1, speaker: "operator", text: "Synthetic user", at: "2026-01-01T00:00:01Z" },
-    { sequence: 2, speaker: "character", reply_to_sequence: 1, text: "Synthetic reply", at: "2026-01-01T00:00:02Z" },
+    { sequence: 2, speaker: "character", reply_to_sequence: 1, text: "Synthetic reply", at: "2026-01-01T00:00:02Z",
+      steps: path.endsWith("/other") ? otherSteps : [] },
   ] })
   throw Error("Unexpected fixture route")
 }, { preconnect: () => {} })
@@ -92,6 +97,19 @@ test("single-message GET returns one object, not the message page", async () =>
 })
 
 
+test("the turn journal becomes native tool items before the reply text", async () => {
+  const body = await (await awFetch("http://fixture.invalid/api/session/other/message/other-reply-1")).json()
+  const [run, refused, text] = body.data.content
+  expect(run).toMatchObject({ type: "tool", id: "other-reply-1-step-0", name: "bash",
+    state: { status: "completed", input: { command: "python3 parse.py" } } })
+  expect(run.state.content[0].text).toBe("port 56733\n… платформа: показано начало, всего 900 симв.")
+  expect(refused).toMatchObject({ type: "tool", name: "helpers_run_script",
+    state: { status: "error", input: { input: '{"file_id": "cut' }, error: { message: "ACCESS_DENIED" } } })
+  expect(text).toEqual({ type: "text", text: "Synthetic reply" })
+  const plain = await (await awFetch("http://fixture.invalid/api/session/session/message/session-reply-1")).json()
+  expect(plain.data.content).toEqual([{ type: "text", text: "Synthetic reply" }])
+})
+
 test("message ids are disjoint between conversations of the same person", async () => {
   const a = await (await awFetch("http://fixture.invalid/api/session/session/message")).json()
   const b = await (await awFetch("http://fixture.invalid/api/session/other/message")).json()
diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
index 121ad76..6039f7f 100644
--- a/packages/app/src/aw/bridge.ts
+++ b/packages/app/src/aw/bridge.ts
@@ -15,8 +15,12 @@ type SessionRow = {
   id: string; scope: Scope; title: string; version: number; state: string
   last_sequence: number; processed_sequence: number; created_at?: string; updated_at?: string
 }
-type Entry = { sequence: number; speaker: "operator" | "character"; text: string | null; withheld: boolean; at: string; reply_to_sequence?: number | null }
-type Progress = { state: string; since: string }
+type Step = { tool: string; status: "completed" | "error"; input: string; output: string; output_chars: number }
+type Entry = {
+  sequence: number; speaker: "operator" | "character"; text: string | null; withheld: boolean; at: string; reply_to_sequence?: number | null
+  steps?: Step[]
+}
+type Progress = { state: string; since: string; steps?: Step[] }
 type Draft = { scope: Scope; utterance_id: string; version: number; revision: number; text: string | null; withheld: boolean; acknowledgeable: boolean }
 type Transcript = {
   scope: Scope; session_id: string; session_version: number; state: string; title: string
@@ -248,10 +252,29 @@ const personAgent = (agent: Agent) => ({
 // Native part caches are shared across sessions of a directory: every owner id is session-scoped.
 const scopedID = (view: Transcript, id: string) => `${view.session_id}-${id}`
 const replyID = (view: Transcript, sequence: number, n = 1) => scopedID(view, n === 1 ? `reply-${sequence}` : `reply-${sequence}-${n}`)
-const assistant = (view: Transcript, id: string, text: string, at: string, done: boolean) => ({
+// The platform's journal of the turn (clipped observations of finished tool calls) as native
+// tool items before the reply text; the input is clipped JSON, kept raw when it no longer parses.
+const toolInput = (input: string): Record<string, unknown> => {
+  try {
+    const value: unknown = JSON.parse(input)
+    if (value && typeof value === "object" && !Array.isArray(value)) return value as Record<string, unknown>
+  } catch {}
+  return { input }
+}
+const toolItems = (id: string, at: string, steps: Step[] = []) =>
+  steps.map((step, index) => {
+    const output = step.output_chars > step.output.length
+      ? `${step.output}\n… платформа: показано начало, всего ${step.output_chars} симв.`
+      : step.output
+    const base = { type: "tool", id: `${id}-step-${index}`, name: step.tool, time: { created: ms(at), completed: ms(at) } }
+    return step.status === "error"
+      ? { ...base, state: { status: "error", input: toolInput(step.input), content: [], structured: {}, error: { type: "unknown", message: output } } }
+      : { ...base, state: { status: "completed", input: toolInput(step.input), content: [{ type: "text", text: output }], structured: {} } }
+  })
+const assistant = (view: Transcript, id: string, text: string, at: string, done: boolean, steps?: Step[]) => ({
   id, type: "assistant", agent: view.scope.persona_id ?? "", model,
   time: done ? { created: ms(at), completed: ms(at) } : { created: ms(at) }, finish: done ? "stop" : undefined,
-  content: [{ type: "text", text }],
+  content: [...toolItems(id, at, steps), { type: "text", text }],
 })
 // The platform's own words about the current turn: a system note, never the person's text.
 const PROGRESS: Record<string, string> = {
@@ -277,14 +300,15 @@ function messages(view: Transcript) {
       const answered = entry.reply_to_sequence ?? entry.sequence
       const n = (replies.get(answered) ?? 0) + 1
       replies.set(answered, n)
-      rows.push(assistant(view, replyID(view, answered, n), text, entry.at, true))
+      rows.push(assistant(view, replyID(view, answered, n), text, entry.at, true, entry.steps))
     }
   }
   // A reply after a ticket answer is a further reply to the same operator message.
   const next = replyID(view, lastOperator, (replies.get(lastOperator) ?? 0) + 1)
   const draft = view.pending_reply
   if (draft && !draft.withheld && draft.text) {
-    rows.push(assistant(view, next, draft.text, view.checked_at, true))
+    const steps = view.progress?.state === "reply_ready" ? view.progress.steps : undefined
+    rows.push(assistant(view, next, draft.text, view.checked_at, true, steps))
     if (draft.acknowledgeable) watchReceipt(draft, view.session_id, next)
   } else if (view.invalidated_reason && !lastOperator) {
     // The stopped conversation's history is no longer shown: a platform placeholder in the
@@ -300,7 +324,8 @@ function messages(view: Transcript) {
   } else if (view.progress && NOTICE.has(view.progress.state) && PROGRESS[view.progress.state]) {
     // A platform notice in the reply's place (never the person's words); a later reply for
     // the same operator message takes this place. Queued/running use the native busy state.
-    rows.push(notice(view, next, PROGRESS[view.progress.state], view.progress.since))
+    // A failed/cancelled/unknown turn still shows what it actually executed.
+    rows.push(notice(view, next, PROGRESS[view.progress.state], view.progress.since, view.progress.steps))
   }
   return rows
 }
@@ -308,9 +333,9 @@ const NOTICE = new Set(["waiting_start", "failed", "cancelled", "unknown"])
 const waitingTicket = (ticketID: string) =>
   `Агент ждёт вашего ответа в обращении. Ответьте в панели: ${location.origin}/#/tickets?ticket=${encodeURIComponent(ticketID)} — разговор продолжится сам.`
 const STOPPED = "Платформа: разговор остановлен — сообщение оператора отозвано, удалено или истекло и не исполнялось. Начните новый разговор."
-const notice = (view: Transcript, id: string, text: string, at: string) => ({
+const notice = (view: Transcript, id: string, text: string, at: string, steps?: Step[]) => ({
   id, type: "assistant", agent: view.scope.persona_id ?? "", model, time: { created: ms(at), completed: ms(at) },
-  finish: "error", content: [], error: { type: "PlatformNotice", message: text },
+  finish: "error", content: toolItems(id, at, steps), error: { type: "PlatformNotice", message: text },
 })
 const running = (view: Transcript) => view.progress?.state === "running" || view.progress?.state === "queued"
 
