From 5f78bdc7cb00a0793877e1ee27bc67a3e4e8352c Mon Sep 17 00:00:00 2001
From: Claude Code <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 11:49:29 +0000
Subject: [PATCH] fix(platform-ui): show turn notices, keep client ids of sent
 messages, hide git details of platform agents

---
 packages/app/src/aw/bridge.ts                 | 27 ++++++++++++++-----
 .../components/session/session-new-view.tsx   |  3 +++
 packages/app/src/pages/home/legacy-home.tsx   |  7 +++--
 packages/app/src/pages/layout.tsx             |  3 ++-
 4 files changed, 30 insertions(+), 10 deletions(-)

diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
index c92b09d..3cad5e4 100644
--- a/packages/app/src/aw/bridge.ts
+++ b/packages/app/src/aw/bridge.ts
@@ -129,6 +129,8 @@ const PROGRESS: Record<string, string> = {
   cancelled: "Рабочий ход отменён (STOP или отзыв допуска). Ответа нет.",
   unknown: "Исход рабочего хода не подтверждён; платформа не повторяет его вслепую.",
 }
+// Client message ids of messages sent from this page (page lifetime only, never persisted).
+const clientIDs = new Map<string, string>()
 function messages(view: Transcript) {
   const rows: Record<string, unknown>[] = []
   let lastOperator = 0
@@ -136,20 +138,28 @@ function messages(view: Transcript) {
     const text = entry.withheld ? "Скрыто: основание сообщения недоступно." : (entry.text ?? "")
     if (entry.speaker === "operator") {
       lastOperator = entry.sequence
-      rows.push({ id: `msg-${entry.sequence}`, type: "user", time: { created: ms(entry.at) }, text })
+      rows.push({ id: clientIDs.get(`${view.session_id}:${entry.sequence}`) ?? `msg-${entry.sequence}`, type: "user", time: { created: ms(entry.at) }, text })
     } else rows.push(assistant(view, replyID(entry.reply_to_sequence ?? entry.sequence), text, entry.at, true))
   }
   const draft = view.pending_reply
   if (draft && !draft.withheld && draft.text) {
     rows.push(assistant(view, replyID(lastOperator), draft.text, view.checked_at, true))
     if (draft.acknowledgeable) watchReceipt(draft, view.session_id, replyID(lastOperator))
-  } else if (view.progress && PROGRESS[view.progress.state]) {
-    rows.push({ id: `status-${lastOperator}-${view.progress.state}`, type: "system", time: { created: ms(view.progress.since) }, text: PROGRESS[view.progress.state] })
+  } else if (view.invalidated_reason) {
+    rows.push(notice(view, replyID(lastOperator), STOPPED, view.checked_at))
+  } else if (view.progress && NOTICE.has(view.progress.state) && PROGRESS[view.progress.state]) {
+    // A platform notice in the reply's place (never the person's words); a later reply for
+    // the same operator message takes this place. Queued/running use the native busy state.
+    rows.push(notice(view, replyID(lastOperator), PROGRESS[view.progress.state], view.progress.since))
   }
-  if (view.invalidated_reason) rows.push({ id: `stopped-${view.session_version}`, type: "system", time: { created: ms(view.checked_at) },
-    text: "Разговор остановлен: сообщение оператора недоступно и не исполнялось. Начните новый разговор." })
   return rows
 }
+const NOTICE = new Set(["waiting_start", "failed", "cancelled", "unknown"])
+const STOPPED = "Разговор остановлен: сообщение оператора недоступно и не исполнялось. Начните новый разговор."
+const notice = (view: Transcript, id: string, text: string, at: string) => ({
+  id, type: "assistant", agent: view.scope.persona_id ?? "", model, time: { created: ms(at), completed: ms(at) },
+  finish: "error", content: [], error: { type: "PlatformNotice", message: text },
+})
 const running = (view: Transcript) => view.progress?.state === "running" || view.progress?.state === "queued"
 
 // ---- receipt: ACK only after the reply is really shown in a visible tab --------------------------
@@ -280,13 +290,16 @@ async function route(method: string, path: string, url: URL, body: () => Promise
       const input = await body()
       const text = String(input.text ?? "")
       const requestID = String(input.id ?? uuid())
-      // The stored message is shown under its owner sequence; answer with that id (no duplicate).
-      const id = `msg-${Math.max(0, ...view.entries.map((entry) => entry.sequence)) + 1}`
+      // The owner stores it under the next sequence (CAS on expected_version). The client already
+      // shows it under its own id: keep that id for this page, so it is not shown twice.
+      const sequence = Math.max(0, ...view.entries.map((entry) => entry.sequence)) + 1
+      const id = input.id ? requestID : `msg-${sequence}`
       await bridge(`/agents/${directory}/commands`, {
         type: "work.session.message", request_id: requestID, scope: stable(view.scope), target: sessionID,
         expected_version: view.session_version,
         arguments: { schema_id: "work.session.message-args", data: { session_id: sessionID, text } },
       })
+      clientIDs.set(`${sessionID}:${sequence}`, id)
       return json({ data: { admittedSeq: 0, id, sessionID, timeCreated: Date.now(), type: "user", data: { text }, delivery: "queue" } })
     }
   }
diff --git a/packages/app/src/components/session/session-new-view.tsx b/packages/app/src/components/session/session-new-view.tsx
index dba0560..eed2593 100644
--- a/packages/app/src/components/session/session-new-view.tsx
+++ b/packages/app/src/components/session/session-new-view.tsx
@@ -56,6 +56,8 @@ export function NewSessionView(props: NewSessionViewProps) {
             <Mark class="w-10" />
             <div class="text-20-medium text-text-strong">{language.t("session.new.title")}</div>
           </div>
+          {/* AW: a platform agent is not a git project: no path, branch or modification time. */}
+          <Show when={!/(^|\/)aw_[0-9a-f]{64}$/.test(projectRoot())}>
           <div class="w-full flex flex-col gap-4 items-center">
             <div class="flex items-start justify-center gap-3 min-h-5">
               <div class="text-12-medium text-text-weak select-text leading-5 min-w-0 max-w-160 break-words text-center">
@@ -84,6 +86,7 @@ export function NewSessionView(props: NewSessionViewProps) {
               )}
             </Show>
           </div>
+          </Show>
         </div>
       </div>
     </div>
diff --git a/packages/app/src/pages/home/legacy-home.tsx b/packages/app/src/pages/home/legacy-home.tsx
index 0556f7c..603e689 100644
--- a/packages/app/src/pages/home/legacy-home.tsx
+++ b/packages/app/src/pages/home/legacy-home.tsx
@@ -106,9 +106,12 @@ export function LegacyHome() {
                     class="text-14-mono text-left justify-between px-3"
                     onClick={() => openProject(server.current!, project.worktree)}
                   >
-                    {project.worktree.replace(homedir(), "~")}
+                    {/* AW: platform agents carry a name; the worktree is an opaque directory key. */}
+                    {project.name ?? project.worktree.replace(homedir(), "~")}
                     <div class="text-14-regular text-text-weak">
-                      {DateTime.fromMillis(project.time.updated ?? project.time.created).toRelative()}
+                      {(project.time.updated ?? project.time.created)
+                        ? DateTime.fromMillis(project.time.updated ?? project.time.created).toRelative()
+                        : ""}
                     </div>
                   </Button>
                 )}
diff --git a/packages/app/src/pages/layout.tsx b/packages/app/src/pages/layout.tsx
index 98548ab..6b58e9c 100644
--- a/packages/app/src/pages/layout.tsx
+++ b/packages/app/src/pages/layout.tsx
@@ -2025,7 +2025,8 @@ export default function LegacyLayout(props: ParentProps) {
                       }}
                     >
                       <span class="text-12-regular text-text-base truncate select-text">
-                        {worktree().replace(homedir(), "~")}
+                        {/* AW: a platform agent's directory key is not a path to show */}
+                        {worktree().startsWith("aw_") ? "" : worktree().replace(homedir(), "~")}
                       </span>
                     </Tooltip>
                   </div>
-- 
