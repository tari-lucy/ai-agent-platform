diff --git a/packages/app/src/aw/bridge.ts b/packages/app/src/aw/bridge.ts
new file mode 100644
index 0000000..a2b095b
--- /dev/null
+++ b/packages/app/src/aw/bridge.ts
@@ -0,0 +1,18 @@
+// AI Agent Platform adapter: the native client talks to the platform bridge `aw-opencode/1`
+// through this fetch. No request reaches a native OpenCode server; unknown routes are refused.
+export const VIRTUAL_SERVER = `${location.origin}/opencode-native`
+
+export const awLog: { method: string; path: string }[] = []
+;(globalThis as unknown as { __awLog: typeof awLog }).__awLog = awLog
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } })
+
+export const awFetch: typeof globalThis.fetch = async (input, init) => {
+  const request = input instanceof Request ? input : new Request(input, init)
+  const url = new URL(request.url)
+  if (!url.href.startsWith(VIRTUAL_SERVER)) return json({ error: "AW_OUTSIDE_BRIDGE" }, 403)
+  const path = url.pathname.slice("/opencode-native".length) || "/"
+  awLog.push({ method: request.method, path: path + url.search })
+  return json({ error: "AW_NOT_AVAILABLE", path }, 501)
+}
