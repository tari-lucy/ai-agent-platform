@@ -660,3 +678,52 @@ export const pageDraftDriver = {
 export async function catalogueDirectories(): Promise<string[]> {
   return (await agents()).map((agent) => agent.directory)
 }
+
+
+// Human-only conversation controls: the same authenticated owner, never a model tool.
+export const managedSessions = (directory: string) => sessions(directory)
+export async function renameConversation(directory: string, sessionID: string, title: string) {
+  const view = await transcript(directory, sessionID)
+  await bridge(`/agents/${directory}/commands`, { type: "work.session.rename", request_id: uuid(),
+    scope: stable(view.scope), target: sessionID, expected_version: view.session_version,
+    arguments: { schema_id: "work.session.rename-args", data: { session_id: sessionID, title } } })
+}
+export async function manageConversation(directory: string, sessionID: string, visibility: "active" | "archived" | "hidden", expectedVersion?: number) {
+  const view = await transcript(directory, sessionID)
+  if (expectedVersion !== undefined && view.session_version !== expectedVersion) throw Object.assign(Error("AW_STALE_SESSION"), { status: 409 })
+  await bridge(`/agents/${directory}/commands`, { type: "work.session.manage", request_id: uuid(),
+    scope: stable(view.scope), target: sessionID, expected_version: view.session_version,
+    arguments: { schema_id: "work.session.manage-args", data: { session_id: sessionID, visibility } } })
+}
+export type ForgetPlan = { directory: string; sessionID: string; scope: Scope; target?: string;
+  plan?: { id: string; version: number; consequences: string; expires_at: string }; requestID: string; count: number; sessionVersion: number }
+export async function previewForget(directory: string, sessionID: string): Promise<ForgetPlan> {
+  const active = (await agents()).find(agent => agent.active_runtime)
+  if (!active) throw Error("Не удалось проверить активный запуск. Откройте панель.")
+  const run = await bridge<{ items: { state: string }[] }>(`/agents/${active.directory}/run`)
+  if (run.items.length !== 1 || run.items[0].state !== "STOPPED") throw Error("Сначала остановите агента кнопкой STOP в панели.")
+  await manageConversation(directory, sessionID, "archived")
+  const selected = await bridge<{ scope: Scope; session_version: number; sources: [string, number][]; complete: boolean }>(`/agents/${directory}/sessions/${sessionID}/sources`)
+  if (!selected.complete) throw Error("Часть источников разговора недоступна. Полное забывание не подтверждено: проверьте очистку памяти в панели. Можно отдельно убрать разговор из списка, сохранив память.")
+  if (selected.sources.length > 200) throw Error("Слишком большой разговор для одной очистки: обратитесь к оператору хранения. Ничего не удалено.")
+  const result: ForgetPlan = { directory, sessionID, scope: selected.scope, requestID: uuid(), count: selected.sources.length, sessionVersion: selected.session_version }
+  if (!selected.sources.length) return result
+  const [target, version] = selected.sources[0]
+  const made = await bridge<{ resource_id: string }>(`/agents/${directory}/commands`, {
+    type: "memory.delete.preview", request_id: uuid(), scope: stable(selected.scope), target,
+    expected_version: version, arguments: { schema_id: "memory.delete-args", data: { source_ids: selected.sources.map(([id]) => id), session_ref: [sessionID, selected.session_version] } },
+  })
+  result.target = target
+  result.plan = await bridge(`/agents/${directory}/plans/${made.resource_id}`)
+  return result
+}
+export async function executeForget(preview: ForgetPlan) {
+  if (preview.plan) {
+    const receipt = await bridge<{ status: string }>(`/agents/${preview.directory}/commands`, {
+      type: "memory.delete.execute", request_id: preview.requestID, scope: stable(preview.scope), target: preview.target,
+      expected_version: preview.plan.version, arguments: { plan_id: preview.plan.id, plan_version: preview.plan.version },
+    })
+    if (receipt.status !== "completed") throw Error("Источники заблокированы, очистка ещё не завершена. Проверьте операции в панели; не повторяйте удаление вслепую.")
+  }
+  await manageConversation(preview.directory, preview.sessionID, "hidden", preview.sessionVersion)
+}
diff --git a/packages/app/src/aw/session-management.tsx b/packages/app/src/aw/session-management.tsx
