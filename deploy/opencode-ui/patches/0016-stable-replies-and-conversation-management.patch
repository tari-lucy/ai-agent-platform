index 0000000..69f7169
--- /dev/null
+++ b/packages/app/src/aw/session-management.tsx
@@ -0,0 +1,76 @@
+import { createSignal, For, Show, onMount, onCleanup } from "solid-js"
+import { managedSessions, manageConversation, renameConversation, previewForget, executeForget,
+  type SessionRow, type ForgetPlan } from "./bridge"
+const home = (directory: string) => `/opencode/${btoa(directory).replaceAll("=", "")}/session`
+const button = "px-3 py-1 rounded border border-border-weak-base hover:bg-surface-base-hover disabled:opacity-50"
+export function SessionManagement(props: { directory: string; sessionID?: string }) {
+  const [mode, setMode] = createSignal("")
+  const [title, setTitle] = createSignal("")
+  const [rows, setRows] = createSignal<SessionRow[]>([])
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal("")
+  const [plan, setPlan] = createSignal<ForgetPlan>()
+  const run = async (action: () => Promise<void>) => {
+    if (busy()) return
+    setBusy(true); setError("")
+    try { await action() }
+    catch (cause) {
+      const status = (cause as { status?: number }).status
+      setError(status === 409 ? "Состояние изменилось или агент работает. Для очистки памяти нажмите STOP в панели и заново посмотрите последствия. Действие не повторяется автоматически."
+        : cause instanceof Error && cause.message && !cause.message.startsWith("AW_") ? cause.message
+        : "Действие не подтверждено. При обрыве удаления повтор использует тот же запрос; проверьте операции в панели.")
+      if (status === 409) setPlan(undefined)
+    } finally { setBusy(false) }
+  }
+  const open = async (next: string) => {
+    setMode(next); setPlan(undefined); setError("")
+    if (next === "archive" || next === "rename") await run(async () => {
+      const items = await managedSessions(props.directory); setRows(items)
+      if (next === "rename") setTitle(items.find(row => row.id === props.sessionID)?.title ?? "")
+    })
+  }
+  const move = (id: string, visibility: "active" | "archived" | "hidden") => run(async () => {
+    await manageConversation(props.directory, id, visibility)
+    location.assign(visibility === "active" ? `${home(props.directory)}/${encodeURIComponent(id)}` : home(props.directory))
+  })
+  onMount(() => {
+    const requested = (event: Event) => {
+      const detail = (event as CustomEvent<{ sessionID: string; action: string }>).detail
+      if (detail?.sessionID === props.sessionID) void open(detail.action)
+    }
+    window.addEventListener("aw-session-manage", requested)
+    onCleanup(() => window.removeEventListener("aw-session-manage", requested))
+  })
+  return <div class="shrink-0 px-4 py-2 border-b border-border-weak-base text-14-regular" data-aw="conversation-controls">
+    <div class="flex gap-2 flex-wrap"><Show when={props.sessionID}>
+      <button class={button} disabled={busy()} onClick={() => void open("rename")}>Переименовать разговор</button>
+      <button class={button} disabled={busy()} onClick={() => void move(props.sessionID!, "archived")}>В архив</button>
+      <button class={button} disabled={busy()} onClick={() => void open("delete")}>Удалить разговор…</button>
+    </Show><button class={button} disabled={busy()} onClick={() => void open("archive")}>Архив разговоров</button></div>
+    <Show when={mode()}><section class="mt-3 p-3 border rounded border-border-weak-base max-h-80 overflow-auto" aria-label="Управление разговором">
+      <Show when={mode() === "rename"}><form onSubmit={(event) => { event.preventDefault(); void run(async () => {
+        await renameConversation(props.directory, props.sessionID!, title().trim()); location.reload()
+      }) }}><label>Название разговора <input disabled={busy()} class="border rounded px-2 py-1" aria-label="Название разговора" value={title()} maxlength={512} onInput={event => setTitle(event.currentTarget.value)} /></label>
+      <button class={button} disabled={busy() || !title().trim()} type="submit">Сохранить название</button></form></Show>
+      <Show when={mode() === "archive"}><p>Архив сохраняет переписку и память. Агент не продолжает архивный разговор.</p>
+        <Show when={rows().some(row => row.visibility === "archived")} fallback={<p>Архив пуст.</p>}>
+        <For each={rows().filter(row => row.visibility === "archived")}>{row => <div class="flex gap-3 py-2 items-center">
+          <a class="underline" href={`${home(props.directory)}/${encodeURIComponent(row.id)}`}>{row.title}</a>
+          <button class={button} disabled={busy()} onClick={() => void move(row.id, "active")}>Вернуть из архива</button>
+        </div>}</For></Show></Show>
+      <Show when={mode() === "delete"}><p>Убрать из списка: переписка и память сохранятся, разговор перестанет исполняться.</p>
+        <button class={button} disabled={busy()} onClick={() => void move(props.sessionID!, "hidden")}>Убрать из списка, сохранить память</button>
+        <p class="mt-3">Удалить переписку и связанную память: необратимая очистка источников платформой. Сначала нажмите STOP в панели. Общие воспоминания с другими основаниями могут сохраниться. При подготовке разговор переместится в архив; незавершённый ход и неподтверждённый черновик будут сброшены. Затем покажем последствия; память до подтверждения не удаляется.</p>
+        <a class="underline" href="/" target="_blank" rel="noopener">Открыть панель для STOP</a>
+        <button class={button} disabled={busy()} onClick={() => void run(async () => { setPlan(await previewForget(props.directory, props.sessionID!)) })}>Заархивировать и посмотреть последствия</button>
+        <Show when={plan()}>{current => <div class="mt-3" role="status"><p>Источников переписки: {current().count}.</p>
+          <p>{current().plan?.consequences ?? "Доступных источников для очистки не осталось. Разговор будет убран из списка."}</p>
+          <p>При сбое очистка останется незавершённой. Внешние копии удаляются отдельно.</p>
+          <button class={button} disabled={busy()} onClick={() => void run(async () => { await executeForget(current()); location.assign(home(props.directory)) })}>Подтверждаю удаление переписки и памяти</button>
+        </div>}</Show>
+      </Show><button class={button + " mt-3"} disabled={busy()} onClick={() => setMode("")}>Закрыть</button>
+    </section></Show>
+    <Show when={busy()}><p role="status">Проверяем и сохраняем…</p></Show>
+    <Show when={error()}><p role="alert">{error()}</p></Show>
+  </div>
+}
