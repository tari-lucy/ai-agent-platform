+test("a read reply keeps its identity and timestamp across ACK, reload data, and a later input", async () => {
+  pendingReply = { scope, utterance_id: "stable-owner-id", version: 1, revision: 1,
+    created_at: "2026-01-01T00:00:04Z", through_sequence: 2,
+    text: "Read reply must stay", withheld: false, acknowledgeable: false }
+  try {
+    const before = await (await awFetch("http://fixture.invalid/api/session/session/message")).json()
+    const draft = before.data.find((row: any) => row.id === "session-utterance-stable-owner-id")
+    expect(draft).toBeDefined()
+    pendingReply = null
+    extraEntries = [
+      { sequence: 3, speaker: "character", reply_to_sequence: 1, reply_id: "stable-owner-id",
+        text: "Read reply must stay", at: "2026-01-01T00:00:04Z" },
+      { sequence: 4, speaker: "operator", text: "Later input", at: "2026-01-01T00:00:05Z" },
+    ]
+    const after = await (await awFetch("http://fixture.invalid/api/session/session/message")).json()
+    const saved = after.data.find((row: any) => row.id === draft.id)
+    expect(saved.time).toEqual(draft.time)
+    expect(saved.content).toEqual(draft.content)
+    expect(saved.aw_parent_id).toBe("session-msg-1")
+    expect(after.data.filter((row: any) => row.id === draft.id)).toHaveLength(1)
+  } finally { pendingReply = null; extraEntries = [] }
+})
